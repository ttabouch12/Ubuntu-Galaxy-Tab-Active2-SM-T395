# Kernel options ztOS needs that /home/claude/gta2ml/out/.config (6.18.0-gta2srv-r3)
# does not set. Merge with scripts/kconfig/merge_config.sh, then olddefconfig.
#
# HARD (ztos-ial/gsi.json "kernel_contract.hard", ztconflo/ztconflo/contract.py):
CONFIG_PSI=y
# ztOS's memory policy (ztos-memory-policy) reads /proc/pressure; PSI on by default
# CONFIG_PSI_DEFAULT_DISABLED is not set
#
# SOFT (Waydroid; without them Android1 reports binder "none" and Waydroid is hidden):
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
#
# Nice to have (not in ztOS's contract):
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UHID=m
CONFIG_HIDRAW=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
# CONFIG_SND/SND_SOC: off in out/.config; PipeWire runs without a card, but the
# volume keys and sounds stay silent until audio exists (cod3026x, not upstream).
