# The panel's brightness (S6D7AA0 DCS backlight; name expected 14800000.dsi.0, UNVERIFIED):
# the shell runs as the user in group video and writes it (as starlte's 90-zrn-backlight.rules).
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/usr/bin/chgrp video /sys%p/brightness", RUN+="/usr/bin/chmod g+w /sys%p/brightness"
