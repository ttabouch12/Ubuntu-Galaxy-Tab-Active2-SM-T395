# ztOS on the Galaxy Tab Active2 (gtactive2lte): read by /usr/local/bin/ztmetro-session
# before ztMETRO starts (same hook as ztos-build/os/overlay-qemu/etc/ztos/session.env).

# The panel is mounted upside down. ztMETRO draws with its own GL straight into
# the output buffer, so wlroots' output transform would not turn anything:
# ztmetro/rotate-180.patch (applied by build-rootfs.sh) adds this switch.
# Touch is NOT rotated: the FTS8 digitizer already reports in the user's frame
# (notes/touch.md: vendor inverted nothing). UNVERIFIED on mainline.
export ZTMETRO_ROTATE=180
# a display plane would scan the app out the panel's way up (the patch also forces this)
export ZTMETRO_NO_PLANE=1

# 800x1280: the automatic scale would be 2.20 (360 points across). UNVERIFIED taste.
export ZTMETRO_SCALE=1.25   # r5 perf: software GL until panfrost (OPTIMIZE.md 5.2); 1.5 with panfrost

# --- until panfrost works (KMS-only bring-up) -----------------------------------
# wlroots refuses llvmpipe unless told; ztMETRO then runs on software GL (slow,
# and `ztconflo promote` would not accept it). Uncomment for a first KMS test:
#export WLR_RENDERER_ALLOW_SOFTWARE=1   # off: panfrost works (r6g)
#export LIBGL_ALWAYS_SOFTWARE=1   # off: panfrost works (r6g)
export WLR_NO_HARDWARE_CURSORS=1

# exynos (DECON) has no render node; Mesa's kmsro pairs card0 with panfrost's
# renderD128 by itself. Only if wlroots picks the wrong card:
#export WLR_DRM_DEVICES=/dev/dri/card0

# --- r5 perf (OPTIMIZE.md 5.2): software GL bring-up on simpledrm ----------------
# llvmpipe on 4 threads leaves 4 cores for apps and input; Qt skips GL entirely.
#export LP_NUM_THREADS=4   # off: panfrost works (r6g)
export QSG_RENDER_LOOP=basic
#export QT_QUICK_BACKEND=software   # off: panfrost works (r6g)
export MESA_SHADER_CACHE_DIR=/var/cache/mesa
export MESA_SHADER_CACHE_MAX_SIZE=128M
# When panfrost works: drop LIBGL_ALWAYS_SOFTWARE / QT_QUICK_BACKEND, ZTMETRO_SCALE=1.5.

# --- r6g: GPU on (Mali-T830, panfrost renderD128) -------------------------------
# simpledrm (card0) shows the picture, panfrost (renderD128) draws it: wlroots
# renders on the GPU and copies into simpledrm's buffer.
export WLR_DRM_DEVICES=/dev/dri/card0
export WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128
# WebKit (Skia) GPU raster draws black pages on Midgard/panfrost: rasterise on the CPU.
export WEBKIT_SKIA_ENABLE_CPU_RENDERING=1
