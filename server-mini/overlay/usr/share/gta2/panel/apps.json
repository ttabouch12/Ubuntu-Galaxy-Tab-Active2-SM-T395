[
 {"id": "filebrowser", "name": "File Browser", "cat": "Files", "desc": "Web file manager for the share folder", "image": "filebrowser/filebrowser:latest",
  "ports": ["8081:80"], "volumes": ["{share}:/srv", "{app}/database:/database", "{app}/config:/config"], "mem": "96m", "ram": 30, "web_port": 8081,
  "note": "First login: admin; the generated password is printed in the app's logs."},
 {"id": "uptime-kuma", "name": "Uptime Kuma", "cat": "Monitoring", "desc": "Monitor websites and services, get alerts", "image": "louislam/uptime-kuma:1",
  "ports": ["3001:3001"], "volumes": ["{app}/data:/app/data"], "mem": "256m", "ram": 110, "web_port": 3001},
 {"id": "adguard", "name": "AdGuard Home", "cat": "Network", "desc": "Network-wide ad and tracker blocking DNS", "image": "adguard/adguardhome:latest",
  "ports": ["53:53/tcp", "53:53/udp", "3000:3000", "8082:80"], "volumes": ["{app}/work:/opt/adguardhome/work", "{app}/conf:/opt/adguardhome/conf"],
  "mem": "160m", "ram": 50, "web_port": 3000, "conflicts": ["pihole"],
  "note": "Uses port 53: needs systemd-resolved's stub listener off (DNSStubListener=no). Setup wizard on :3000, then the UI moves to :8082."},
 {"id": "pihole", "name": "Pi-hole", "cat": "Network", "desc": "Classic DNS ad blocker", "image": "pihole/pihole:latest",
  "ports": ["53:53/tcp", "53:53/udp", "8083:80"], "volumes": ["{app}/etc-pihole:/etc/pihole"], "env": ["TZ={tz}", "FTLCONF_webserver_api_password=gta2"],
  "mem": "192m", "ram": 90, "web_port": 8083, "web_path": "/admin", "conflicts": ["adguard"],
  "note": "Web password: gta2 (change it). Uses port 53 like AdGuard: install only one."},
 {"id": "homeassistant", "name": "Home Assistant", "cat": "Smart home", "desc": "Home automation hub", "image": "ghcr.io/home-assistant/home-assistant:stable",
  "network": "host", "volumes": ["{app}/config:/config"], "env": ["TZ={tz}"], "mem": "900m", "ram": 380, "web_port": 8123, "heavy": true,
  "note": "Heavy for 3 GB: first start takes several minutes."},
 {"id": "jellyfin", "name": "Jellyfin", "cat": "Media", "desc": "Movies and music streaming (no hardware transcoding: direct play only)", "image": "jellyfin/jellyfin:latest",
  "ports": ["8096:8096"], "volumes": ["{app}/config:/config", "{app}/cache:/cache", "{share}:/media"], "mem": "768m", "ram": 300, "web_port": 8096, "heavy": true},
 {"id": "navidrome", "name": "Navidrome", "cat": "Media", "desc": "Your music collection, Subsonic compatible", "image": "deluan/navidrome:latest",
  "ports": ["4533:4533"], "volumes": ["{app}/data:/data", "{share}/Music:/music:ro"], "mem": "128m", "ram": 40, "web_port": 4533,
  "note": "Put music in the Music folder of the share."},
 {"id": "syncthing", "name": "Syncthing", "cat": "Files", "desc": "Sync folders between your devices", "image": "syncthing/syncthing:latest",
  "ports": ["8384:8384", "22000:22000/tcp", "22000:22000/udp", "21027:21027/udp"], "volumes": ["{app}/data:/var/syncthing", "{share}:/var/syncthing/share"],
  "env": ["PUID={uid}", "PGID={gid}"], "mem": "256m", "ram": 70, "web_port": 8384},
 {"id": "transmission", "name": "Transmission", "cat": "Downloads", "desc": "Light BitTorrent client", "image": "lscr.io/linuxserver/transmission:latest",
  "ports": ["9091:9091", "51413:51413/tcp", "51413:51413/udp"], "volumes": ["{app}/config:/config", "{share}/Downloads:/downloads"],
  "env": ["PUID={uid}", "PGID={gid}", "TZ={tz}"], "mem": "128m", "ram": 35, "web_port": 9091, "conflicts": ["qbittorrent"]},
 {"id": "qbittorrent", "name": "qBittorrent", "cat": "Downloads", "desc": "BitTorrent client with a full web UI", "image": "lscr.io/linuxserver/qbittorrent:latest",
  "ports": ["8085:8085", "6881:6881/tcp", "6881:6881/udp"], "volumes": ["{app}/config:/config", "{share}/Downloads:/downloads"],
  "env": ["PUID={uid}", "PGID={gid}", "TZ={tz}", "WEBUI_PORT=8085"], "mem": "256m", "ram": 80, "web_port": 8085,
  "note": "Temporary admin password is printed in the app's logs."},
 {"id": "vaultwarden", "name": "Vaultwarden", "cat": "Security", "desc": "Bitwarden-compatible password manager", "image": "vaultwarden/server:latest",
  "ports": ["8086:80"], "volumes": ["{app}/data:/data"], "mem": "128m", "ram": 25, "web_port": 8086,
  "note": "Browsers need HTTPS for the web vault: use Tailscale HTTPS or Nginx Proxy Manager."},
 {"id": "gitea", "name": "Gitea", "cat": "Dev", "desc": "Self-hosted Git service", "image": "gitea/gitea:latest",
  "ports": ["3002:3000", "2222:22"], "volumes": ["{app}/data:/data"], "env": ["USER_UID={uid}", "USER_GID={gid}"], "mem": "256m", "ram": 110, "web_port": 3002},
 {"id": "nodered", "name": "Node-RED", "cat": "Smart home", "desc": "Flow-based automation", "image": "nodered/node-red:latest",
  "ports": ["1880:1880"], "volumes": ["{app}/data:/data"], "mem": "256m", "ram": 90, "web_port": 1880, "chown": "1000:1000"},
 {"id": "mosquitto", "name": "Mosquitto", "cat": "Smart home", "desc": "MQTT broker for IoT devices (port 1883, no web UI)", "image": "eclipse-mosquitto:2",
  "ports": ["1883:1883"], "volumes": ["{app}/data:/mosquitto/data"], "cmd": ["mosquitto", "-c", "/mosquitto-no-auth.conf"], "mem": "32m", "ram": 8,
  "note": "Open broker without login: keep it on your LAN."},
 {"id": "homepage", "name": "Homepage", "cat": "Dashboard", "desc": "Customizable start page for all your services", "image": "ghcr.io/gethomepage/homepage:latest",
  "ports": ["3003:3000"], "volumes": ["{app}/config:/app/config", "/var/run/docker.sock:/var/run/docker.sock:ro"], "env": ["HOMEPAGE_ALLOWED_HOSTS=*"],
  "mem": "192m", "ram": 90, "web_port": 3003},
 {"id": "dozzle", "name": "Dozzle", "cat": "Monitoring", "desc": "Live logs of all containers", "image": "amir20/dozzle:latest",
  "ports": ["8087:8080"], "volumes": ["/var/run/docker.sock:/var/run/docker.sock:ro"], "mem": "64m", "ram": 15, "web_port": 8087},
 {"id": "npm", "name": "Nginx Proxy Manager", "cat": "Network", "desc": "Reverse proxy with free Let's Encrypt certificates", "image": "jc21/nginx-proxy-manager:latest",
  "ports": ["8880:80", "81:81", "8443:443"], "volumes": ["{app}/data:/data", "{app}/letsencrypt:/etc/letsencrypt"], "mem": "256m", "ram": 140, "web_port": 81,
  "note": "Port 80 is this panel, so the proxy listens on 8880 / 8443. Default login admin@example.com / changeme."},
 {"id": "nextcloud", "name": "Nextcloud", "cat": "Files", "desc": "Full cloud suite (files, calendar, contacts)", "image": "nextcloud:apache",
  "ports": ["8090:80"], "volumes": ["{app}/html:/var/www/html"], "mem": "768m", "ram": 350, "web_port": 8090, "heavy": true,
  "note": "Heavy and slow on this tablet: File Browser + Syncthing cover most needs with a tenth of the RAM."}
]
