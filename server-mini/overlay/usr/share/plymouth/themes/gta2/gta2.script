// gta2srv boot screen: black, thin "gta2srv" title, five accent-blue dots sliding across
// with the Windows Phone easing (fast in, slow through the middle, fast out), staggered, looping.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
W = Window.GetWidth();
H = Window.GetHeight();

title_img = Image.Text("gta2srv", 1, 1, 1, 1, "Sans Light 40");
title = Sprite(title_img);
title.SetPosition(W / 2 - title_img.GetWidth() / 2, H / 2 - title_img.GetHeight() - 30, 1);

dot_img = Image("dot.png");
N = 5;
for (i = 0; i < N; i++) {
  dot[i] = Sprite(dot_img);
  dot[i].SetY(H / 2 + 40);
  dot[i].SetX(-50);
  dot[i].SetOpacity(0);
}

t = 0;
PERIOD = 3.2;   // seconds per loop
TRAVEL = 2.0;   // seconds one dot takes to cross
GAP = 0.14;     // stagger between dots

fun refresh_callback() {
  t = t + 1 / 50;
  c = t - Math.Int(t / PERIOD) * PERIOD;
  for (i = 0; i < N; i++) {
    p = (c - i * GAP) / TRAVEL;
    if (p < 0 || p > 1) {
      dot[i].SetOpacity(0);
    } else {
      u = 2 * p - 1;                      // -1 .. 1
      e = u * u * u * 0.85 + u * 0.15;    // cubic: slow through the middle
      dot[i].SetX(W / 2 + e * (W / 2 + 20) - 4);
      dot[i].SetOpacity(1);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

// messages (e.g. fsck) stay small and unobtrusive at the bottom
msg = Sprite();
fun message_callback(text) {
  msg.SetImage(Image.Text(text, 0.6, 0.6, 0.6, 1, "Sans 12"));
  msg.SetPosition(W / 2 - msg.GetImage().GetWidth() / 2, H - 60, 2);
}
Plymouth.SetMessageFunction(message_callback);
