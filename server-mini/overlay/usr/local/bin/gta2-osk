#!/usr/bin/python3
# gta2srv on-screen keyboard, Gboard style: rounded keys, number row, ?123 and =\< symbol pages,
# long-press a letter for accents, hold backspace to repeat, Shift (tap = one letter, double tap = caps),
# a terminal toolbar (Esc Tab Ctrl Alt arrows). Never takes the focus: it types into the app below.
#   size: ~/.config/gta2/osk_size (S, M or L)
import tkinter as tk, subprocess, ctypes, ctypes.util, os, time
try:
    ctypes.CDLL(None).prctl(15, b'matchbox-keyboa', 0, 0, 0)  # keep the old pgrep/pkill toggles working
except Exception:
    pass
from PIL import Image, ImageDraw, ImageTk

BG, KEY, MOD, HI, FG, ACC = '#1b1e23', '#3b4049', '#2b2f36', '#565d69', '#f1f3f6', '#5b8cff'
F = 'DejaVu Sans'
try:
    SZ = open(os.path.expanduser('~/.config/gta2/osk_size')).read().strip().upper()
except OSError:
    SZ = 'L'
RH = {'S': 66, 'M': 80, 'L': 94}.get(SZ, 94)   # key row height
TH = int(RH * .72)                               # toolbar height

ACCENTS = {'a': 'àáâäãåæ', 'e': 'èéêëē', 'i': 'ìíîïı', 'o': 'òóôöõøœ', 'u': 'ùúûü', 'c': 'çć', 'n': 'ñń',
           's': 'şßś', 'g': 'ğ', 'y': 'ýÿ', 'z': 'žźż', 'l': 'ł', '1': '¹½¼', '2': '²', '3': '³¾', '0': '°',
           '-': '–—_', '.': '…·', '?': '¿', '!': '¡', '$': '€£¥¢', '%': '‰', '"': '«»“”', "'": '‘’'}
NAMES = {'`': 'grave', '~': 'asciitilde', '!': 'exclam', '@': 'at', '#': 'numbersign', '$': 'dollar', '%': 'percent',
         '^': 'asciicircum', '&': 'ampersand', '*': 'asterisk', '(': 'parenleft', ')': 'parenright', '-': 'minus',
         '_': 'underscore', '=': 'equal', '+': 'plus', '[': 'bracketleft', '{': 'braceleft', ']': 'bracketright',
         '}': 'braceright', '\\': 'backslash', '|': 'bar', ';': 'semicolon', ':': 'colon', "'": 'apostrophe',
         '"': 'quotedbl', ',': 'comma', '<': 'less', '.': 'period', '>': 'greater', '/': 'slash', '?': 'question', ' ': 'space'}

# key spec: (label, action, width). action: 'c:x' type char, 'k:Keysym', 'm:mod', 'L:layer', 'hide'
def chars(s, w=1.0):
    return [(c, 'c:' + c, w) for c in s]


TOOLBAR = [('Esc', 'k:Escape', 1), ('Tab', 'k:Tab', 1), ('Ctrl', 'm:ctrl', 1), ('Alt', 'm:alt', 1),
           ('←', 'k:Left', 1), ('↓', 'k:Down', 1), ('↑', 'k:Up', 1), ('→', 'k:Right', 1), ('⌄', 'hide', 1)]
LAYERS = {
    'abc': [chars('1234567890'), chars('qwertyuiop'), [('', None, .5)] + chars('asdfghjkl') + [('', None, .5)],
            [('⇧', 'm:shift', 1.5)] + chars('zxcvbnm') + [('⌫', 'k:BackSpace', 1.5)],
            [('?123', 'L:sym', 1.5), (',', 'c:,', 1), ('space', 'c: ', 5), ('.', 'c:.', 1), ('⏎', 'k:Return', 1.5)]],
    'sym': [chars('1234567890'), chars('@#$_&-+()/'), chars('*"\':;!?%=') + [('', None, 1)],
            [('=\\<', 'L:sym2', 1.5)] + chars(',.~`|\\') + [('', None, 1), ('⌫', 'k:BackSpace', 1.5)],
            [('ABC', 'L:abc', 1.5), ('<', 'c:<', 1), ('space', 'c: ', 5), ('>', 'c:>', 1), ('⏎', 'k:Return', 1.5)]],
    'sym2': [chars('1234567890'), chars('~`|•√π÷×¶∆'), chars('£¢€¥^°={}'), [('?123', 'L:sym', 1.5)] + chars('\\©®™✓[]') + [('⌫', 'k:BackSpace', 1.5)],
             [('ABC', 'L:abc', 1.5), ('<', 'c:<', 1), ('space', 'c: ', 5), ('>', 'c:>', 1), ('⏎', 'k:Return', 1.5)]],
}

st = {'layer': 'abc', 'shift': 0, 'last_shift': 0, 'ctrl': False, 'alt': False}

_imgs = {}


def rr(w, h, r, col):
    k = (w, h, r, col)
    if k not in _imgs:
        s = 3
        im = Image.new('RGBA', (w * s, h * s), (0, 0, 0, 0))
        ImageDraw.Draw(im).rounded_rectangle((0, 0, w * s - 1, h * s - 1), r * s, fill=col)
        _imgs[k] = ImageTk.PhotoImage(im.resize((w, h), Image.LANCZOS))
    return _imgs[k]


def xdo(*a):
    subprocess.Popen(['xdotool'] + list(a))


def send_char(ch):
    mods = ''.join(m + '+' for m in ('ctrl', 'alt') if st[m])
    if mods:
        xdo('key', mods + NAMES.get(ch, ch.lower()))
    elif ch.isascii() and (ch.isalnum() or ch in NAMES):
        xdo('key', NAMES.get(ch, ch))
    else:
        xdo('type', '--', ch)


def send_key(ks):
    mods = ''.join(m + '+' for m in ('ctrl', 'alt') if st[m])
    xdo('key', mods + ks)


r = tk.Tk(className='gta2-osk')
r.configure(bg=BG)
W, H = r.winfo_screenwidth(), r.winfo_screenheight()
KH = TH + RH * 5 + 14
r.overrideredirect(True)
r.geometry('%dx%d+0+%d' % (W, KH, H - KH))
r.attributes('-topmost', True)
cv = tk.Canvas(r, width=W, height=KH, bg=BG, highlightthickness=0, bd=0)
cv.pack()
keys = []   # (x0, y0, x1, y1, label, action)


def label_of(lab, act):
    if act and act.startswith('c:') and lab.isalpha() and len(lab) == 1 and st['shift']:
        return lab.upper()
    return lab


def draw(pressed=None):
    cv.delete('all')
    keys.clear()
    pad = 4
    rows = [(TOOLBAR, TH, 4)] + [(row, RH, 0) for row in LAYERS[st['layer']]]
    y = 6
    for row, h, extra in rows:
        units = sum(k[2] for k in row)
        uw = (W - 8) / units
        x = 4
        for lab, act, w in row:
            kw = uw * w
            if act:
                x0, y0, x1, y1 = int(x + pad / 2), int(y + pad / 2), int(x + kw - pad / 2), int(y + h - pad / 2)
                special = not act.startswith('c:') or lab in ('space',)
                col = KEY
                if act.startswith(('k:', 'm:', 'L:')) or act == 'hide' or h == TH:
                    col = MOD
                if act == 'k:Return':
                    col = ACC
                m = act[2:] if act.startswith('m:') else None
                if m and ((m == 'shift' and st['shift']) or (m in ('ctrl', 'alt') and st[m])):
                    col = ACC if not (m == 'shift' and st['shift'] == 2) else '#f2a93b'
                if pressed is not None and pressed == (x0, y0):
                    col = HI
                cv.create_image(x0, y0, image=rr(x1 - x0, y1 - y0, 12 if h == RH else 10, col), anchor='nw')
                t = label_of(lab, act)
                if lab == 'space':
                    t = ''
                fs = int(h * (.36 if len(t) == 1 else .26))
                cv.create_text((x0 + x1) // 2, (y0 + y1) // 2, text=t, fill=FG, font=(F, fs, 'bold' if len(t) > 1 else 'normal'))
                if act.startswith('c:') and lab.lower() in ACCENTS and st['layer'] == 'abc' and lab.isalpha():
                    cv.create_text(x1 - 10, y0 + 12, text='·', fill='#8a93a3', font=(F, 10))
                keys.append((x0, y0, x1, y1, lab, act))
            x += kw
        y += h + extra


def hit(x, y):
    for k in keys:
        if k[0] <= x <= k[2] and k[1] <= y <= k[3]:
            return k
    return None


touch = {'key': None, 't': 0.0, 'lp': None, 'rep': None, 'pop': None, 'popsel': None}


def act_key(k):
    lab, act = k[4], k[5]
    if act == 'hide':
        r.destroy(); return
    if act.startswith('L:'):
        st['layer'] = act[2:]; st['shift'] = 0; draw(); return
    if act.startswith('m:'):
        m = act[2:]
        if m == 'shift':
            now = time.time()
            if st['shift'] == 1 and now - st['last_shift'] < .45:
                st['shift'] = 2
            else:
                st['shift'] = 0 if st['shift'] else 1
            st['last_shift'] = now
        else:
            st[m] = not st[m]
        draw(); return
    if act.startswith('k:'):
        send_key(act[2:])
    else:
        ch = act[2:]
        if st['shift'] and ch.isalpha():
            ch = ch.upper()
        send_char(ch)
        if st['shift'] == 1:
            st['shift'] = 0
    if st['ctrl'] or st['alt']:
        st['ctrl'] = st['alt'] = False
    draw()


def show_popup(k):
    base = k[4].lower()
    opts = ACCENTS.get(base, '')
    if not opts:
        return
    if st['shift']:
        opts = opts.upper()
    n = len(opts)
    bw = max(58, k[2] - k[0])
    w = bw * n + 8
    x0 = min(max(4, k[0] - 4), W - w - 4)
    y0 = max(2, k[1] - RH - 4)
    cv.create_image(x0, y0, image=rr(w, RH, 14, '#4a505b'), anchor='nw', tags='pop')
    items = []
    for i, ch in enumerate(opts):
        cx = x0 + 4 + bw * i
        items.append((cx, y0, cx + bw, y0 + RH, ch))
        cv.create_text(cx + bw // 2, y0 + RH // 2, text=ch, fill=FG, font=(F, int(RH * .36)), tags='pop')
    touch['pop'] = items
    touch['popsel'] = None


def pop_pick(x):
    if not touch['pop']:
        return None
    cv.delete('popsel')
    for it in touch['pop']:
        if it[0] <= x <= it[2]:
            cv.create_rectangle(it[0] + 2, it[1] + 4, it[2] - 2, it[3] - 4, outline=ACC, width=3, tags=('pop', 'popsel'))
            return it[4]
    return None


def on_press(e):
    k = hit(e.x, e.y)
    touch.update(key=k, t=time.time(), pop=None, popsel=None)
    if not k:
        return
    draw(pressed=(k[0], k[1]))
    if k[5] == 'k:BackSpace':
        send_key('BackSpace')

        def rep():
            if touch['key'] is k:
                send_key('BackSpace'); touch['rep'] = r.after(70, rep)
        touch['rep'] = r.after(450, rep)
    elif k[5] and k[5].startswith('c:') and k[4].lower() in ACCENTS:
        touch['lp'] = r.after(420, lambda: touch['key'] is k and show_popup(k))


def on_motion(e):
    if touch['pop']:
        touch['popsel'] = pop_pick(e.x)


def on_release(e):
    k = touch['key']
    for t in ('lp', 'rep'):
        if touch[t]:
            r.after_cancel(touch[t]); touch[t] = None
    touch['key'] = None
    if touch['pop']:
        ch = touch['popsel'] or pop_pick(e.x)
        touch['pop'] = None
        if ch:
            send_char(ch)
            if st['shift'] == 1:
                st['shift'] = 0
        draw(); return
    if k and k[5] and k[5] != 'k:BackSpace':
        act_key(k)
    else:
        draw()


cv.bind('<ButtonPress-1>', on_press)
cv.bind('<B1-Motion>', on_motion)
cv.bind('<ButtonRelease-1>', on_release)


def nofocus():  # ICCCM input hint off: the window manager never gives us the keyboard focus
    try:
        X = ctypes.CDLL(ctypes.util.find_library('X11'))

        class WMH(ctypes.Structure):
            _fields_ = [('flags', ctypes.c_long), ('input', ctypes.c_int), ('initial_state', ctypes.c_int),
                        ('icon_pixmap', ctypes.c_ulong), ('icon_window', ctypes.c_ulong), ('icon_x', ctypes.c_int),
                        ('icon_y', ctypes.c_int), ('icon_mask', ctypes.c_ulong), ('window_group', ctypes.c_ulong)]
        X.XOpenDisplay.restype = ctypes.c_void_p
        d = X.XOpenDisplay(None)
        h = WMH(); h.flags = 1; h.input = 0
        for w in {r.winfo_id()}:
            X.XSetWMHints(ctypes.c_void_p(d), ctypes.c_ulong(w), ctypes.byref(h))
        X.XFlush(ctypes.c_void_p(d))
    except Exception:
        pass


r.after(100, nofocus)
draw()
r.mainloop()
