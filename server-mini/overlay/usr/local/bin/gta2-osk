#!/usr/bin/python3
# gta2srv on-screen keyboard: big keys, full PC layout, never takes the focus (types into the app below).
#   layers: Shift (tap = one letter, double tap = lock), Caps, Ctrl/Alt (sticky for the next key),
#   "Fn/àé" = accents + F1-F12 on the number row + Del/Home/End/PgUp/PgDn/Esc.
#   size: ~/.config/gta2/osk_size  (S, M or L; default L).  Toggle: RECENTS key, or the ▾ key to hide.
import tkinter as tk, subprocess, ctypes, ctypes.util, os, time
try:  # process name = "matchbox-keyboa" so the existing pgrep/pkill toggles keep working
    ctypes.CDLL(None).prctl(15, b'matchbox-keyboa', 0, 0, 0)
except Exception:
    pass

BG, KEY, MOD, ON, FG = '#0b0f14', '#2a313b', '#1c222a', '#2f81f7', '#e6edf3'
SIZE = {'S': 62, 'M': 76, 'L': 92}
try:
    RH = SIZE.get(open(os.path.expanduser('~/.config/gta2/osk_size')).read().strip().upper(), 92)
except OSError:
    RH = 92

NAMES = {'`': 'grave', '~': 'asciitilde', '!': 'exclam', '@': 'at', '#': 'numbersign', '$': 'dollar', '%': 'percent',
         '^': 'asciicircum', '&': 'ampersand', '*': 'asterisk', '(': 'parenleft', ')': 'parenright', '-': 'minus',
         '_': 'underscore', '=': 'equal', '+': 'plus', '[': 'bracketleft', '{': 'braceleft', ']': 'bracketright',
         '}': 'braceright', '\\': 'backslash', '|': 'bar', ';': 'semicolon', ':': 'colon', "'": 'apostrophe',
         '"': 'quotedbl', ',': 'comma', '<': 'less', '.': 'period', '>': 'greater', '/': 'slash', '?': 'question', ' ': 'space'}
# (label, shifted, fn-layer, width)  fn-layer: text to type, or "@keysym"
R1 = [('`', '~', '@Escape:Esc'), ('1', '!', '@F1:F1'), ('2', '@', '@F2:F2'), ('3', '#', '@F3:F3'), ('4', '$', '@F4:F4'),
      ('5', '%', '@F5:F5'), ('6', '^', '@F6:F6'), ('7', '&', '@F7:F7'), ('8', '*', '@F8:F8'), ('9', '(', '@F9:F9'),
      ('0', ')', '@F10:F10'), ('-', '_', '@F11:F11'), ('=', '+', '@F12:F12'), ('@BackSpace:⌫', None, '@Delete:Del', 1.6)]
R2 = [('@Tab:Tab', None, None, 1.4)] + [(c, c.upper(), a) for c, a in zip('qwertyuiop', 'âŵéèêëùîôö')] + \
     [('[', '{', '«'), (']', '}', '»'), ('\\', '|', '¦')]
R3 = [('#caps:Caps', None, None, 1.6)] + [(c, c.upper(), a) for c, a in zip('asdfghjkl', 'àşäáğüûïı')] + \
     [(';', ':', '¿'), ("'", '"', '¡'), ('@Return:Enter', None, None, 1.9)]
R4 = [('#shift:Shift', None, None, 2.0)] + [(c, c.upper(), a) for c, a in zip('zxcvbnm', 'æœçßñóí')] + \
     [(',', '<', 'ú'), ('.', '>', '…'), ('/', '?', 'İ'), ('@Up:↑', None, '@Prior:PgUp'), ('#shift:Shift', None, None, 1.4)]
R5 = [('#ctrl:Ctrl', None, None, 1.5), ('#alt:Alt', None, None, 1.3), ('#fn:Fn àé', None, None, 1.6),
      (' ', None, None, 4.4), ('@Left:←', None, '@Home:Home'), ('@Down:↓', None, '@Next:PgDn'),
      ('@Right:→', None, '@End:End'), ('#hide:▾', None, None, 1.0)]
ROWS = [R1, R2, R3, R4, R5]

st = {'shift': 0, 'caps': False, 'ctrl': False, 'alt': False, 'fn': False, 'last_shift': 0}


def xdo(*a):
    subprocess.Popen(['xdotool'] + list(a))


def mods():
    m = [x for x in ('ctrl', 'alt') if st[x]]
    return ''.join(x + '+' for x in m)


def send_keysym(ks):
    xdo('key', mods() + ks)


def press(spec):
    lab, sh_, fn = spec[0], spec[1], spec[2]
    if lab.startswith('#'):
        k = lab[1:].split(':')[0]
        if k == 'hide':
            r.destroy(); return
        if k == 'shift':
            now = time.time()
            if st['shift'] == 1 and now - st['last_shift'] < .4:
                st['shift'] = 2
            else:
                st['shift'] = 0 if st['shift'] else 1
            st['last_shift'] = now
        else:
            st[k] = not st[k]
        draw(); return
    if st['fn'] and fn:
        if fn.startswith('@'):
            send_keysym(fn[1:].split(':')[0])
        else:
            xdo('type', '--', fn)
    elif lab.startswith('@'):
        send_keysym(lab[1:].split(':')[0])
    else:
        up = (st['shift'] > 0) != (st['caps'] and lab.isalpha())
        ch = sh_ if (st['shift'] > 0 and sh_) else (lab.upper() if up and lab.isalpha() else lab)
        if st['ctrl'] or st['alt']:
            send_keysym(NAMES.get(ch.lower() if ch.isalpha() else ch, ch.lower()))
        elif ch.isascii() and (ch.isalnum() or ch in NAMES):
            xdo('key', NAMES.get(ch, ch))
        else:
            xdo('type', '--', ch)
    if st['shift'] == 1:
        st['shift'] = 0
    st['ctrl'] = st['alt'] = False
    draw()


def label(spec):
    lab, sh_, fn = spec[0], spec[1], spec[2]
    if st['fn'] and fn:
        return fn.split(':')[1] if fn.startswith('@') else fn
    if lab.startswith(('@', '#')):
        return lab.split(':', 1)[1]
    if lab == ' ':
        return 'space'
    if st['shift'] and sh_:
        return sh_
    if st['caps'] and lab.isalpha():
        return lab.upper()
    return lab


r = tk.Tk(className='gta2-osk')
r.configure(bg=BG)
W, H = r.winfo_screenwidth(), r.winfo_screenheight()
KH = RH * len(ROWS) + 8
r.overrideredirect(True)
r.geometry('%dx%d+0+%d' % (W, KH, H - KH))
r.attributes('-topmost', True)
keys = []
for row in ROWS:
    f = tk.Frame(r, bg=BG); f.pack(fill='both', expand=True, padx=2, pady=1)
    for spec in row:
        w = spec[3] if len(spec) > 3 else 1.0
        modkey = spec[0].startswith(('#', '@')) and spec[0] not in (' ',)
        b = tk.Label(f, text='', bg=MOD if modkey else KEY, fg=FG, font=('DejaVu Sans', int(RH * .30), 'bold'),
                     bd=0, relief='flat')
        b.pack(side='left', fill='both', expand=True, padx=2, pady=2)
        b.pack_configure(ipadx=int(w * 10))
        f.pack_propagate(True)
        b.bind('<ButtonPress-1>', lambda e, s=spec, b=b: down(b, s))
        b.bind('<ButtonRelease-1>', lambda e: up())
        keys.append((b, spec, w))


# one key event per finger tap. (No "xdotool --clearmodifiers": it releases and re-presses the mouse button
# that the finger is holding, which Tk saw as new taps = repeats, and left the button stuck = blocked input.)
tap = {'t': 0.0}


def down(b, s):
    now = time.time()
    if now - tap['t'] < 0.04:  # same touch reported twice
        return
    tap['t'] = now
    b.configure(bg=ON)
    press(s)


def up():
    r.after(60, draw)


def draw():
    for b, spec, w in keys:
        lab = spec[0]
        k = lab[1:].split(':')[0] if lab.startswith('#') else None
        active = k and ((k == 'shift' and st['shift']) or (k in ('caps', 'ctrl', 'alt', 'fn') and st[k]))
        modkey = lab.startswith(('#', '@'))
        b.configure(text=label(spec), bg=ON if active else (MOD if modkey else KEY),
                    fg='#ffd866' if (st['shift'] == 2 and k == 'shift') else FG)


# proportional key widths: give every key a share of the row width
def layout(e=None):
    for row_frame in r.winfo_children():
        items = [(b, w) for b, s, w in keys if b.master is row_frame]
        tot = sum(w for _, w in items)
        x = 0
        for b, w in items:
            b.pack_forget()
        for b, w in items:
            b.place(in_=row_frame, relx=x / tot, rely=0, relwidth=w / tot, relheight=1, width=-4, x=2)
            x += w
r.after(50, layout)


def nofocus():  # ICCCM: input hint False -> the WM never gives us the keyboard focus
    try:
        X = ctypes.CDLL(ctypes.util.find_library('X11'))

        class WMH(ctypes.Structure):
            _fields_ = [('flags', ctypes.c_long), ('input', ctypes.c_int), ('initial_state', ctypes.c_int),
                        ('icon_pixmap', ctypes.c_ulong), ('icon_window', ctypes.c_ulong), ('icon_x', ctypes.c_int),
                        ('icon_y', ctypes.c_int), ('icon_mask', ctypes.c_ulong), ('window_group', ctypes.c_ulong)]
        X.XOpenDisplay.restype = ctypes.c_void_p
        d = X.XOpenDisplay(None)
        h = WMH(); h.flags = 1; h.input = 0
        wid = int(r.wm_frame(), 16) if r.wm_frame() else r.winfo_id()
        for w in {wid, r.winfo_id()}:
            X.XSetWMHints(ctypes.c_void_p(d), ctypes.c_ulong(w), ctypes.byref(h))
        X.XFlush(ctypes.c_void_p(d))
    except Exception:
        pass


r.after(100, nofocus)
draw()
r.mainloop()
