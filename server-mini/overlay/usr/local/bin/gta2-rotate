#!/usr/bin/python3
# gta2-rotate: screen rotation for the Galaxy Tab Active2 (X11, DSI-1 800x1280).
#   gta2-rotate set {normal|left|right|inverted}   rotate now (also used by Settings > display)
#   gta2-rotate auto {on|off}                       turn auto-rotation on/off (saved in ~/.config/gta2/ui.json)
#   gta2-rotate daemon                              follow the LSM6DS3 accelerometer (iio), ~1 s hysteresis
#   gta2-rotate status
# A lock file /tmp/gta2-rotate.lock (e.g. desktop mode forcing landscape) pauses the daemon.
import glob, json, os, subprocess, sys, time

OUT = 'DSI-1'
UI = os.path.expanduser('~/.config/gta2/ui.json')
LOCK = '/tmp/gta2-rotate.lock'
STATE = '/tmp/gta2-rotate.state'
# touch matrices ("Coordinate Transformation Matrix") for each xrandr rotation. The Tab Active2's touch layer reports
# 180 degrees turned against the modesetting display (/etc/gta2/rotation = portrait-flip), so compose with that.
PLAIN = {
    'normal':   '1 0 0 0 1 0 0 0 1',
    'inverted': '-1 0 1 0 -1 1 0 0 1',
    'left':     '0 -1 1 1 0 0 0 0 1',
    'right':    '0 1 0 -1 0 1 0 0 1',
}
FLIP = {
    'normal':   '-1 0 1 0 -1 1 0 0 1',
    'inverted': '1 0 0 0 1 0 0 0 1',
    'left':     '0 1 0 -1 0 1 0 0 1',
    'right':    '0 -1 1 1 0 0 0 0 1',
}
try: MATRIX = FLIP if open('/etc/gta2/rotation').read().strip() == 'portrait-flip' else PLAIN
except OSError: MATRIX = PLAIN
DESKTOP = os.path.expanduser('~/.config/gta2/desktop')  # desktop mode owns the rotation
os.environ.setdefault('DISPLAY', ':0')


def sh(*c):
    return subprocess.run(list(c), capture_output=True, text=True).stdout


def current():
    for l in sh('xrandr', '--query').splitlines():
        if l.startswith(OUT + ' '):
            p = l.split('(')[0].split()
            for r in ('left', 'right', 'inverted'):
                if r in p: return r
            return 'normal'
    return 'normal'


def touch_devices():
    return [d for d in sh('xinput', 'list', '--name-only').splitlines() if any(k in d.lower() for k in ('touch', 'fts', 'pen'))]


def apply(rot):
    if rot not in MATRIX: raise SystemExit('bad rotation: %s' % rot)
    if rot != current():
        subprocess.call(['xrandr', '--output', OUT, '--rotate', rot]); time.sleep(0.3)
        subprocess.call(['sudo', '-n', '/usr/local/sbin/gta2-60hz'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # a modeset restores the 30 Hz divider
    for d in touch_devices():
        subprocess.call(['xinput', 'set-prop', d, 'Coordinate Transformation Matrix'] + MATRIX[rot].split(), stderr=subprocess.DEVNULL)
    open(STATE, 'w').write(rot)


def cfg(upd=None):
    try: c = json.load(open(UI))
    except Exception: c = {}
    if upd:
        c.update(upd); os.makedirs(os.path.dirname(UI), exist_ok=True); json.dump(c, open(UI, 'w'))
    return c


def accel():
    """iio accelerometer of the LSM6DS3 (st_lsm6dsx): returns (x, y, z) in m/s^2 or None"""
    for d in glob.glob('/sys/bus/iio/devices/iio:device*'):
        if os.path.exists(d + '/in_accel_x_raw'):
            try:
                s = float(open(d + '/in_accel_scale').read()) if os.path.exists(d + '/in_accel_scale') else 1.0
                return tuple(int(open('%s/in_accel_%s_raw' % (d, a)).read()) * s for a in 'xyz')
            except (OSError, ValueError):
                return None
    return None


def orientation(x, y, z):
    """Which way is up. Axis mapping for this tablet is set by AXES (env GTA2_ROT_AXES='xy+-' to tune)."""
    g = 9.81
    if abs(z) > 0.8 * g: return None              # lying flat: keep the current rotation
    m = os.environ.get('GTA2_ROT_AXES', cfg().get('rot_axes', 'xy++'))
    ax, ay = {'x': x, 'y': y}[m[0]], {'x': x, 'y': y}[m[1]]
    ax *= 1 if m[2] == '+' else -1; ay *= 1 if m[3] == '+' else -1
    if abs(ay) >= abs(ax): return 'normal' if ay > 0 else 'inverted'
    return 'left' if ax > 0 else 'right'


def daemon():
    cand, since = None, 0
    while True:
        time.sleep(0.25)
        if os.path.exists(LOCK) or os.path.exists(DESKTOP) or not cfg().get('autorotate', True): cand = None; continue
        a = accel()
        if not a: time.sleep(5); continue          # no sensor (yet): idle cheaply
        o = orientation(*a)
        if o is None or o == current(): cand = None; continue
        if o != cand: cand, since = o, time.time(); continue
        if time.time() - since >= 1.0: apply(o); cand = None


if __name__ == '__main__':
    a = sys.argv[1:] or ['status']
    if a[0] == 'set' and len(a) > 1: apply(a[1])
    elif a[0] == 'auto' and len(a) > 1: cfg({'autorotate': a[1] == 'on'}); print('autorotate', a[1])
    elif a[0] == 'daemon': daemon()
    elif a[0] == 'status': print(json.dumps({'rotation': current(), 'autorotate': cfg().get('autorotate', True), 'sensor': accel() is not None, 'locked': os.path.exists(LOCK)}))
    else: raise SystemExit(__doc__ if False else 'usage: gta2-rotate set ROT | auto on|off | daemon | status')
