#!/bin/sh
# gta2-sd add|remove <kernel name>: mount the microSD card (udev, 99-gta2-sd.rules) at /media/sdcard and show it in the Files share
# as "SD card". vfat/exfat get gta2 ownership; ext4/btrfs keep their own permissions. Partitionless cards work too.
A=$1; D=/dev/$2; M=/media/sdcard; L=/userdata/gta2srv/share/SD\ card
case "$A" in
add)
  T=$(blkid -o value -s TYPE "$D" 2>/dev/null); [ -n "$T" ] || exit 0
  mountpoint -q $M && exit 0
  mkdir -p $M
  case "$T" in
    vfat|exfat) O="rw,noatime,uid=1000,gid=1000,umask=002,iocharset=utf8" ;;
    ntfs) T=ntfs3; O="rw,noatime,uid=1000,gid=1000,umask=002" ;;
    *) O="rw,noatime" ;;
  esac
  mount -t "$T" -o "$O" "$D" $M && { ln -sfn $M "$L"; logger -t gta2-sd "mounted $D ($T) on $M"; } ;;
remove)
  umount -l $M 2>/dev/null; rm -f "$L"; logger -t gta2-sd "removed $D" ;;
esac
