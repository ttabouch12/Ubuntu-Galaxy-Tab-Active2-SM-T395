</div><script>
const $=id=>document.getElementById(id),f=(n,d=0)=>n==null?'–':Number(n).toLocaleString(undefined,{maximumFractionDigits:d});
const card=(k,v,s='',pct,col='#3b8eea')=>`<div class=c style="border-top:3px solid ${col};background:linear-gradient(160deg,${col}33,rgba(22,27,34,.66) 60%)"><div class=k style="color:${col}">${k}</div><div class=v>${v}</div><div class=s>${s}</div>${pct!=null?`<div class=b><i style="width:${Math.min(100,pct)}%;background:${col}"></i></div>`:''}</div>`;
const lvl=(v,a,b)=>v==null?'#8e9aaf':v<a?'#56d364':v<b?'#e3b341':'#ff7b72';
const ago=t=>{const s=Math.floor(Date.now()/1000-t);return s<90?s+' s ago':s<5400?Math.round(s/60)+' min ago':Math.round(s/3600)+' h ago'};
const dur=s=>s<90?s+' s':s<5400?Math.round(s/60)+' min':(s/3600).toFixed(1)+' h';
async function tick(){try{const d=await (await fetch('/api',{cache:'no-store'})).json();
$('time').textContent=d.time;const u=d.uptime;$('sub').textContent=`${d.date} · ${d.host} · up ${Math.floor(u/86400)}d ${Math.floor(u%86400/3600)}h`;
if(d.wallpaper&&!document.body.dataset.wp){document.body.style.backgroundImage='url(/wallpaper)';document.body.dataset.wp=1}
const p=d.pihole;$('ph').innerHTML=p?card('Blocked',f(p.percent,1)+' %','of all queries today',p.percent,'#ff6b9d')+card('Total queries',f(p.total),`${f(p.clients)} active clients`,null,'#a78bfa')+card('Queries blocked',f(p.blocked),`${f(p.domains)} domains on blocklists`,null,'#fb923c'):card('Pi-hole','offline','not reachable on :8083');
const n=d.net;if(n){const on=n.online;$('net').className='pill'+(on?'':' off');$('net').textContent=on?'● Online':'● Offline'+(n.down_since?' for '+dur(Math.floor(Date.now()/1000)-n.down_since):'');
const L=n.lat,sp=(n.speed||[]).slice(-1)[0];
$('inet').innerHTML=card('Latency',`${f(L['1.1.1.1'],0)} ms`,`router ${f(L.router,0)} ms · 8.8.8.8 ${f(L['8.8.8.8'],0)} ms`,null,lvl(L['1.1.1.1'],30,80))+
card('Live traffic',`↓ ${f(n.rate.rx,1)} <span class=s>Mbit/s</span>`,`↑ ${f(n.rate.tx,1)} Mbit/s`,null,'#22d3ee')+
card('Speed test',sp?`↓ ${f(sp.down,0)} <span class=s>/ ↑ ${f(sp.up,0)} Mbit/s</span>`:(n.testing?'testing…':'–'),(sp?`ping ${f(sp.ping,0)} ms · ${ago(sp.t)} `:'')+`<button onclick="fetch('/speedtest',{method:'POST'});this.textContent='started'">Run now</button>`,null,'#3b8eea')+
card('Average speed (last 24 h)',(()=>{const a=(n.speed||[]).filter(x=>x.down);return a.length?`↓ ${f(a.reduce((s,x)=>s+x.down,0)/a.length,0)} <span class=s>Mbit/s</span>`:'–'})(),`${(n.speed||[]).length} tests kept`,null,'#34d399');
const h=n.hist||[];if(h.length>1){const mx=Math.max(1,...h.map(x=>Math.max(x[2]||0,x[3]||0))),X=i=>i*300/(h.length-1),Y=v=>58-56*(v||0)/mx;
$('spark').innerHTML=`<polyline fill=none stroke="#3b8eea" stroke-width=2 points="${h.map((x,i)=>X(i)+','+Y(x[2])).join(' ')}"/><polyline fill=none stroke="#56d364" stroke-width=1.5 points="${h.map((x,i)=>X(i)+','+Y(x[3])).join(' ')}"/>`}
const lh=h.filter(x=>x[1]!=null);if(lh.length>1){const lm=Math.max(5,...lh.map(x=>x[1])),X=i=>i*300/(lh.length-1),Y=v=>58-56*v/lm;
$('latmx').textContent=`(max ${f(lm,0)} ms)`;$('lats').innerHTML=`<polyline fill=none stroke="#e3b341" stroke-width=2 points="${lh.map((x,i)=>X(i)+','+Y(x[1])).join(' ')}"/>`}
const st=(n.speed||[]).filter(x=>x.down!=null).slice(-48);if(st.length){const sm=Math.max(1,...st.map(x=>Math.max(x.down,x.up||0))),w=300/st.length;
$('spmx').textContent=`(max ${f(sm,0)} Mbit/s)`;$('sps').innerHTML=st.map((x,i)=>`<rect x="${i*w+1}" y="${58-56*x.down/sm}" width="${Math.max(1,w/2-1)}" height="${56*x.down/sm}" fill="#3b8eea"/><rect x="${i*w+w/2}" y="${58-56*(x.up||0)/sm}" width="${Math.max(1,w/2-1)}" height="${56*(x.up||0)/sm}" fill="#56d364"/>`).join('')}
$('out').innerHTML=(n.outages||[]).slice().reverse().map(o=>`<tr><td>${new Date(o.start*1000).toLocaleString()}</td><td class=bad>${dur(o.end-o.start)}</td></tr>`).join('')||'<tr><td class=ok>none recorded</td></tr>'}
