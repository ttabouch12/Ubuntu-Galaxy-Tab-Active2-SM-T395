.k{color:#9aa7b4;font-size:12px;text-transform:uppercase;letter-spacing:.5px}.v{font-size:26px;font-weight:700;margin-top:2px}.s{font-size:12px;color:#9aa7b4}
.b{height:5px;background:rgba(255,255,255,.12);border-radius:3px;margin-top:7px}.b i{display:block;height:5px;border-radius:3px;background:#3b8eea}
.sec{color:#7cc4ff;font-weight:700;margin:14px 2px 6px;font-size:13px;text-transform:uppercase;letter-spacing:.8px}
svg{width:100%;height:60px;display:block;margin-top:6px}button{background:#3b8eea;color:#fff;border:0;border-radius:8px;padding:6px 10px;font-weight:700}
table{width:100%;border-collapse:collapse}td{padding:5px 2px;font-size:13px;border-bottom:1px solid rgba(255,255,255,.06)}
.ok{color:#56d364}.bad{color:#ff7b72}
</style></head><body><div class=wrap>
<div class=top><div><h1 id=time>--:--</h1><div class=sub id=sub></div></div><div class="pill" id=net>…</div></div>
