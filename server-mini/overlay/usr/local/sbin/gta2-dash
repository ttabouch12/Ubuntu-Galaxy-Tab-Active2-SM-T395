<div class=sec>Internet</div><div class=g id=inet></div>
<div class=g><div class=c style="border-top:3px solid #e3b341"><div class=k style="color:#e3b341">Latency to 1.1.1.1, last 3 h <span id=latmx></span></div><svg id=lats viewBox="0 0 300 60" preserveAspectRatio=none></svg></div>
<div class=c style="border-top:3px solid #3b8eea"><div class=k style="color:#3b8eea">Speed tests, every 15 min (down / up) <span id=spmx></span></div><svg id=sps viewBox="0 0 300 60" preserveAspectRatio=none></svg></div></div>
<div class=c style="border-top:3px solid #22d3ee"><div class=k style="color:#22d3ee">Traffic, last 3 h (down / up)</div><svg id=spark viewBox="0 0 300 60" preserveAspectRatio=none></svg></div>
<div class=sec>Tablet</div><div class="g g3" id=sys></div>
