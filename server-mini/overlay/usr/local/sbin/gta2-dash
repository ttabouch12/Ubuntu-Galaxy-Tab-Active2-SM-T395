#!/usr/bin/python3
# gta2srv dashboard, one HTTP request per process (systemd socket activation, Accept=yes): 0 MB when idle.
# http://<tablet>:8088  - no login, meant for the kiosk screen and LAN monitoring.
#   /            the page (updates itself every 5 s, no full reload)
#   /api         JSON: system, Pi-hole, network monitor (gta2-netmon), containers
#   /wallpaper   your wallpaper: put wallpaper.jpg/.png/.webp into the Files share (/userdata/gta2srv/share)
#   /speedtest   (POST) ask gta2-netmon for a speed test now
import glob, json, os, socket, subprocess, sys, time, urllib.request

SHARE = '/userdata/gta2srv/share'


def rd(p, d=''):
    try: return open(p).read().strip()
    except OSError: return d


def sh(c):
    try: return subprocess.run(c, shell=True, capture_output=True, text=True, timeout=4).stdout.strip()
    except Exception: return ''


def send(code, ctype, body, extra=''):
    if isinstance(body, str): body = body.encode()
    cc = '' if 'Cache-Control' in extra else 'Cache-Control: no-store\r\n'
    sys.stdout.buffer.write(('HTTP/1.0 %s\r\nContent-Type: %s\r\nContent-Length: %d\r\n%s%sConnection: close\r\n\r\n'
                             % (code, ctype, len(body), cc, extra)).encode() + body)
    sys.stdout.flush()


def pihole():
    try:
        with urllib.request.urlopen('http://127.0.0.1:8083/api/stats/summary', timeout=2) as r:
            j = json.load(r)
        q = j.get('queries', {})
        return {'total': q.get('total'), 'blocked': q.get('blocked'), 'percent': round(q.get('percent_blocked') or 0, 1),
                'clients': j.get('clients', {}).get('active'), 'domains': j.get('gravity', {}).get('domains_being_blocked')}
    except Exception:
        return None


def api():
    m = dict(l.split(':', 1) for l in open('/proc/meminfo'))
    kb = lambda k: int(m[k].split()[0]) // 1024
    tot, av = kb('MemTotal'), kb('MemAvailable')
    temp = rd('/sys/class/thermal/thermal_zone0/temp', '0')
    cap = (glob.glob('/sys/class/power_supply/*/capacity') or [''])[0]
    bdir = os.path.dirname(cap)
    chg = (glob.glob('/sys/class/power_supply/*charger*/online') or [''])[0]
    disks = []
    for name, path in (('System', '/'), ('Data', '/userdata'), ('SD card', '/media/sdcard')):
        if path == '/media/sdcard' and not os.path.ismount(path): continue
        try:
            s = os.statvfs(path); t = s.f_blocks * s.f_frsize; f = s.f_bavail * s.f_frsize
            disks.append({'name': name, 'used': round((t - f) / 2**30, 1), 'total': round(t / 2**30, 1)})
        except OSError: pass
    cpu = [int(rd(p, '0')) // 1000 for p in sorted(glob.glob('/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq'))]
    try: net = json.load(open('/run/gta2/netmon.json'))
    except Exception: net = None
    dk = sh("docker ps --format '{{.Names}}|{{.Status}}' 2>/dev/null")
    return {'host': socket.gethostname(), 'time': time.strftime('%H:%M'), 'date': time.strftime('%A %d %B'),
            'uptime': int(float(rd('/proc/uptime', '0').split()[0])), 'load': rd('/proc/loadavg').split()[:3],
            'mem': [tot - av, tot], 'temp': int(temp) // 1000 if temp.isdigit() else None, 'cpu_mhz': cpu,
            'battery': {'pct': int(rd(cap, '0') or 0), 'status': rd(bdir + '/status'), 'plugged': rd(chg, '0') == '1'} if cap else None,
            'disks': disks, 'pihole': pihole(), 'net': net,
            'containers': [dict(zip(('name', 'status'), (l.split('|') + [''])[:2])) for l in dk.splitlines()],
            'wallpaper': bool(wallpaper())}


def wallpaper():
    for ext in ('jpg', 'jpeg', 'png', 'webp'):
        for p in (f'{SHARE}/wallpaper.{ext}', f'{SHARE}/Wallpaper.{ext}'):
            if os.path.isfile(p): return p
    return None


PAGE = r'''<!doctype html><html><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>gta2srv</title><style>
*{box-sizing:border-box}html,body{margin:0;height:100%}
body{background:#0b0f14 center/cover no-repeat fixed;color:#eef2f7;font:15px "DejaVu Sans",sans-serif}
.wrap{min-height:100%;padding:22px;background:linear-gradient(180deg,rgba(8,11,16,.55),rgba(8,11,16,.78))}
h1{font-size:64px;margin:0;font-weight:700;letter-spacing:-1px}.sub{color:#b6c0cc;margin:2px 0 16px}
.top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.pill{padding:8px 14px;border-radius:999px;font-weight:700;font-size:14px;background:rgba(46,160,67,.85)}.pill.off{background:rgba(218,54,51,.9)}
.g{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:10px}.g3{grid-template-columns:repeat(3,1fr)}
.c{background:rgba(22,27,34,.62);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:12px 14px}
.k{color:#9aa7b4;font-size:12px;text-transform:uppercase;letter-spacing:.5px}.v{font-size:26px;font-weight:700;margin-top:2px}.s{font-size:12px;color:#9aa7b4}
.b{height:5px;background:rgba(255,255,255,.12);border-radius:3px;margin-top:7px}.b i{display:block;height:5px;border-radius:3px;background:#3b8eea}
.sec{color:#cfd8e3;font-weight:700;margin:14px 2px 6px;font-size:13px;text-transform:uppercase;letter-spacing:.8px}
svg{width:100%;height:60px;display:block;margin-top:6px}button{background:#3b8eea;color:#fff;border:0;border-radius:8px;padding:6px 10px;font-weight:700}
table{width:100%;border-collapse:collapse}td{padding:5px 2px;font-size:13px;border-bottom:1px solid rgba(255,255,255,.06)}
.ok{color:#56d364}.bad{color:#ff7b72}
</style></head><body><div class=wrap>
<div class=top><div><h1 id=time>--:--</h1><div class=sub id=sub></div></div><div class="pill" id=net>…</div></div>
<div class=sec>Pi-hole</div><div class="g g3" id=ph></div>
<div class=sec>Internet</div><div class=g id=inet></div>
<div class=c><div class=k>Traffic, last 3 h (down / up)</div><svg id=spark viewBox="0 0 300 60" preserveAspectRatio=none></svg></div>
<div class=sec>Tablet</div><div class="g g3" id=sys></div>
<div class=g><div class=c><div class=k>Containers</div><table id=ct></table></div><div class=c><div class=k>Recent outages</div><table id=out></table></div></div>
</div><script>
const $=id=>document.getElementById(id),f=(n,d=0)=>n==null?'–':Number(n).toLocaleString(undefined,{maximumFractionDigits:d});
const card=(k,v,s='',pct)=>`<div class=c><div class=k>${k}</div><div class=v>${v}</div><div class=s>${s}</div>${pct!=null?`<div class=b><i style="width:${Math.min(100,pct)}%"></i></div>`:''}</div>`;
const ago=t=>{const s=Math.floor(Date.now()/1000-t);return s<90?s+' s ago':s<5400?Math.round(s/60)+' min ago':Math.round(s/3600)+' h ago'};
const dur=s=>s<90?s+' s':s<5400?Math.round(s/60)+' min':(s/3600).toFixed(1)+' h';
async function tick(){try{const d=await (await fetch('/api',{cache:'no-store'})).json();
$('time').textContent=d.time;const u=d.uptime;$('sub').textContent=`${d.date} · ${d.host} · up ${Math.floor(u/86400)}d ${Math.floor(u%86400/3600)}h`;
if(d.wallpaper&&!document.body.dataset.wp){document.body.style.backgroundImage='url(/wallpaper)';document.body.dataset.wp=1}
const p=d.pihole;$('ph').innerHTML=p?card('Blocked',f(p.percent,1)+' %','of all queries today',p.percent)+card('Total queries',f(p.total),`${f(p.clients)} active clients`)+card('Queries blocked',f(p.blocked),`${f(p.domains)} domains on blocklists`):card('Pi-hole','offline','not reachable on :8083');
const n=d.net;if(n){const on=n.online;$('net').className='pill'+(on?'':' off');$('net').textContent=on?'● Online':'● Offline'+(n.down_since?' for '+dur(Math.floor(Date.now()/1000)-n.down_since):'');
const L=n.lat,sp=(n.speed||[]).slice(-1)[0];
$('inet').innerHTML=card('Latency',`${f(L['1.1.1.1'],0)} ms`,`router ${f(L.router,0)} ms · 8.8.8.8 ${f(L['8.8.8.8'],0)} ms`)+
card('Live traffic',`↓ ${f(n.rate.rx,1)} <span class=s>Mbit/s</span>`,`↑ ${f(n.rate.tx,1)} Mbit/s`)+
card('Speed test',sp?`↓ ${f(sp.down,0)} <span class=s>/ ↑ ${f(sp.up,0)} Mbit/s</span>`:(n.testing?'testing…':'–'),(sp?`ping ${f(sp.ping,0)} ms · ${ago(sp.t)} `:'')+`<button onclick="fetch('/speedtest',{method:'POST'});this.textContent='started'">Run now</button>`)+
card('Average speed (last tests)',(()=>{const a=(n.speed||[]).filter(x=>x.down);return a.length?`↓ ${f(a.reduce((s,x)=>s+x.down,0)/a.length,0)} <span class=s>Mbit/s</span>`:'–'})(),`${(n.speed||[]).length} tests kept`);
const h=n.hist||[];if(h.length>1){const mx=Math.max(1,...h.map(x=>Math.max(x[2]||0,x[3]||0))),X=i=>i*300/(h.length-1),Y=v=>58-56*(v||0)/mx;
$('spark').innerHTML=`<polyline fill=none stroke="#3b8eea" stroke-width=2 points="${h.map((x,i)=>X(i)+','+Y(x[2])).join(' ')}"/><polyline fill=none stroke="#56d364" stroke-width=1.5 points="${h.map((x,i)=>X(i)+','+Y(x[3])).join(' ')}"/>`}
$('out').innerHTML=(n.outages||[]).slice().reverse().map(o=>`<tr><td>${new Date(o.start*1000).toLocaleString()}</td><td class=bad>${dur(o.end-o.start)}</td></tr>`).join('')||'<tr><td class=ok>none recorded</td></tr>'}
const b=d.battery,m=d.mem;$('sys').innerHTML=card('CPU',`${f(d.temp)} °C`,`load ${d.load.join(' ')} · ${d.cpu_mhz.join('/')} MHz`,d.temp)+card('Memory',`${f(m[0])} MB`,`of ${f(m[1])} MB`,100*m[0]/m[1])+
(b?card('Battery',b.pct+' %',(b.plugged?'plugged in · ':'')+b.status,b.pct):'')+d.disks.map(x=>card(x.name,`${x.used} GB`,`of ${x.total} GB`,100*x.used/x.total)).join('');
$('ct').innerHTML=d.containers.map(c=>`<tr><td>${c.name}</td><td class=${c.status.startsWith('Up')?'ok':'bad'}>${c.status}</td></tr>`).join('')||'<tr><td>none</td></tr>';
}catch(e){$('net').textContent='dashboard offline';$('net').className='pill off'}}
tick();setInterval(tick,5000);
</script></body></html>'''


try:
    req = sys.stdin.readline().split()
except Exception:
    req = []
meth, path = (req + ['GET', '/'])[:2]
path = path.split('?')[0]
if path == '/api':
    send('200 OK', 'application/json', json.dumps(api()))
elif path == '/wallpaper':
    p = wallpaper()
    if p:
        ct = {'png': 'image/png', 'webp': 'image/webp'}.get(p.rsplit('.', 1)[-1].lower(), 'image/jpeg')
        send('200 OK', ct, open(p, 'rb').read(), 'Cache-Control: max-age=300\r\n')
    else:
        send('404 Not Found', 'text/plain', 'no wallpaper')
elif path == '/speedtest' and meth == 'POST':
    try: open('/run/gta2/speedtest.now', 'w').close(); send('200 OK', 'text/plain', 'ok')
    except OSError: send('500 Error', 'text/plain', 'netmon not running')
else:
    send('200 OK', 'text/html; charset=utf-8', PAGE)
