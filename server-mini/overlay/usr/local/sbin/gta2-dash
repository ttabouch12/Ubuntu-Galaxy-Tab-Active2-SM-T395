#!/usr/bin/python3
# gta2srv dashboard, one HTTP request per process (systemd socket activation, Accept=yes): 0 MB when idle.
# http://<tablet>:8088  - no login, meant for the kiosk screen and LAN monitoring.
#   /            the page (updates itself every 5 s, no full reload)
#   /api         JSON: system, Pi-hole, network monitor (gta2-netmon), containers
#   /wallpaper   your wallpaper: put wallpaper.jpg/.png/.webp into the Files share (/userdata/gta2srv/share)
#   /speedtest   (POST) ask gta2-netmon for a speed test now
import glob, json, os, socket, subprocess, sys, time, urllib.request

SHARE = '/userdata/gta2srv/share'


def rd(p, d=''):
    try: return open(p).read().strip()
    except OSError: return d


def sh(c):
    try: return subprocess.run(c, shell=True, capture_output=True, text=True, timeout=4).stdout.strip()
    except Exception: return ''


def send(code, ctype, body, extra=''):
    if isinstance(body, str): body = body.encode()
    cc = '' if 'Cache-Control' in extra else 'Cache-Control: no-store\r\n'
    sys.stdout.buffer.write(('HTTP/1.0 %s\r\nContent-Type: %s\r\nContent-Length: %d\r\n%s%sConnection: close\r\n\r\n'
                             % (code, ctype, len(body), cc, extra)).encode() + body)
    sys.stdout.flush()


def pihole():
    try:
        with urllib.request.urlopen('http://127.0.0.1:8083/api/stats/summary', timeout=2) as r:
            j = json.load(r)
        q = j.get('queries', {})
        return {'total': q.get('total'), 'blocked': q.get('blocked'), 'percent': round(q.get('percent_blocked') or 0, 1),
                'clients': j.get('clients', {}).get('active'), 'domains': j.get('gravity', {}).get('domains_being_blocked')}
    except Exception:
        return None


def api():
    m = dict(l.split(':', 1) for l in open('/proc/meminfo'))
    kb = lambda k: int(m[k].split()[0]) // 1024
    tot, av = kb('MemTotal'), kb('MemAvailable')
    temp = rd('/sys/class/thermal/thermal_zone0/temp', '0')
    cap = (glob.glob('/sys/class/power_supply/*/capacity') or [''])[0]
    bdir = os.path.dirname(cap)
    chg = (glob.glob('/sys/class/power_supply/*charger*/online') or [''])[0]
    disks = []
    for name, path in (('System', '/'), ('Data', '/userdata'), ('Share drive', SHARE), ('SD card', '/media/sdcard')):
        if path in (SHARE, '/media/sdcard') and not os.path.ismount(path): continue
        try:
            s = os.statvfs(path); t = s.f_blocks * s.f_frsize; f = s.f_bavail * s.f_frsize
            disks.append({'name': name, 'used': round((t - f) / 2**30, 1), 'total': round(t / 2**30, 1)})
        except OSError: pass
    cpu = [int(rd(p, '0')) // 1000 for p in sorted(glob.glob('/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq'))]
    try: net = json.load(open('/run/gta2/netmon.json')); net.pop('tgt', None)
    except Exception: net = None
    try: router = json.load(open('/run/gta2/router.json'))  # gta2-router (Zyxel WAN stats), optional
    except Exception: router = None
    dk = sh("docker ps --format '{{.Names}}|{{.Status}}' 2>/dev/null")
    return {'host': socket.gethostname(), 'time': time.strftime('%H:%M'), 'date': time.strftime('%A %d %B'),
            'uptime': int(float(rd('/proc/uptime', '0').split()[0])), 'load': rd('/proc/loadavg').split()[:3],
            'mem': [tot - av, tot], 'temp': int(temp) // 1000 if temp.isdigit() else None, 'cpu_mhz': cpu,
            'battery': {'pct': int(rd(cap, '0') or 0), 'status': rd(bdir + '/status'), 'plugged': rd(chg, '0') == '1'} if cap else None,
            'disks': disks, 'pihole': pihole(), 'net': net, 'router': {k: v for k, v in (router or {}).items() if k != 'hosts'} or None,
            'containers': [dict(zip(('name', 'status'), (l.split('|') + [''])[:2])) for l in dk.splitlines()],
            'wallpaper': bool(wallpaper()), 'netinfo': netinfo(), 'kernel': os.uname().release,
            'cpu_pct': cpu_pct(), 'docker_total': len(sh("docker ps -aq 2>/dev/null").split())}


def cpu_pct():  # CPU use over 0.3 s
    def snap():
        a = list(map(int, open('/proc/stat').readline().split()[1:])); return a[3] + a[4], sum(a)
    i0, t0 = snap(); time.sleep(0.3); i1, t1 = snap()
    return round(100 * (1 - (i1 - i0) / max(1, t1 - t0)))


def netinfo():
    """interfaces with address, kind, link speed, Wi-Fi details, gateway (for the Home page)"""
    out = {'ifs': [], 'gw': None, 'wifi': None}
    try: addrs = json.loads(sh('ip -j -4 addr') or '[]')
    except Exception: addrs = []
    for i in addrs:
        n = i.get('ifname', '')
        if n == 'lo' or n.startswith(('docker', 'veth', 'br-', 'hassio')): continue
        ip = next((a['local'] + '/' + str(a['prefixlen']) for a in i.get('addr_info', []) if a.get('local')), None)
        d = '/sys/class/net/' + n
        kind = ('wifi' if os.path.isdir(d + '/wireless') else 'vpn' if n.startswith(('wg', 'tailscale', 'tun', 'zt'))
                else 'usb' if n.startswith(('usb', 'rndis')) else 'ethernet')
        sp = rd(d + '/speed', '')
        out['ifs'].append({'name': n, 'kind': kind, 'ip': ip, 'up': rd(d + '/operstate') in ('up', 'unknown'),
                           'speed': int(sp) if sp.lstrip('-').isdigit() and int(sp) > 0 else None,
                           'rx': int(rd(d + '/statistics/rx_bytes', '0') or 0), 'tx': int(rd(d + '/statistics/tx_bytes', '0') or 0)})
    try: out['gw'] = (json.loads(sh('ip -j route show default') or '[]') or [{}])[0].get('gateway')
    except Exception: pass
    w = sh("nmcli -t -f IN-USE,SSID,SIGNAL,FREQ,RATE,SECURITY dev wifi list --rescan no 2>/dev/null | grep '^\\*'")
    if w:
        p = w.replace('\\:', '\x00').split(':')
        p = [x.replace('\x00', ':') for x in p] + [''] * 6
        out['wifi'] = {'ssid': p[1], 'signal': int(p[2]) if p[2].isdigit() else None, 'freq': p[3], 'rate': p[4], 'sec': p[5]}
    return out


# ---------- /detail?k=<tile>: read-only breakdown for the home screen's detail pages.
# Returns a small view model the QML renders generically:
#   {"hero": [[label, value, unit], ...], "charts": [{"name", "unit", "series": [{"c": colour, "pts": [..]}]}],
#    "sections": [{"head", "rows": [[k, v], ...]}], "actions": [[label, action]]}
DETAIL_KEYS = {'net', 'lat', 'sp', 'dev', 'ph', 'phq', 'cpu', 'mem', 'bat', 'disk', 'wifi', 'today', 'up', 'ctr'}


def jf(p):
    try: return json.load(open(p))
    except Exception: return {}


def gbs(b):
    if b is None: return '–'
    b = float(b)
    return '%.2f TB' % (b / 1e12) if b >= 1e12 else '%.1f GB' % (b / 1e9) if b >= 1e9 else '%.0f MB' % (b / 1e6)


def dur(s):
    if s is None: return '–'
    s = int(s); d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return '%dd %dh' % (d, h) if d else '%dh %dm' % (h, m) if h else '%dm' % m


def ps_top(sort, n=8):
    rows = []
    for l in sh("ps -eo comm,pcpu,rss --sort=-%s --no-headers | head -%d" % (sort, n)).splitlines():
        p = l.split()
        if len(p) >= 3: rows.append([p[0][:22], '%s%% cpu · %d MB' % (p[1], int(p[2]) // 1024)])
    return rows


def pistat(path):
    try:
        with urllib.request.urlopen('http://127.0.0.1:8083/api/' + path, timeout=2) as r: return json.load(r)
    except Exception: return {}


def lat_stats(vals):
    ok = [v for v in vals if v is not None]
    if not vals: return None
    if not ok: return {'loss': 100.0}
    jit = sum(abs(a - b) for a, b in zip(ok, ok[1:])) / max(1, len(ok) - 1)
    return {'avg': sum(ok) / len(ok), 'min': min(ok), 'max': max(ok), 'jit': jit, 'loss': 100.0 * (len(vals) - len(ok)) / len(vals), 'cur': vals[-1]}


def detail(k):
    net, rt = jf('/run/gta2/netmon.json'), jf('/run/gta2/router.json')
    H, C, S, A = [], [], [], []
    if k == 'net' or k == 'today':
        if rt.get('ok'):
            H = [['download', '%.1f' % (rt.get('rx_mbit') or 0), 'Mbit/s'], ['upload', '%.1f' % (rt.get('tx_mbit') or 0), 'Mbit/s'],
                 ['today', gbs((rt.get('day_rx') or 0) + (rt.get('day_tx') or 0)).split()[0], gbs((rt.get('day_rx') or 0) + (rt.get('day_tx') or 0)).split()[1]]]
            S.append({'head': 'whole home (router)', 'rows': [
                ['now', '↓ %.1f  ↑ %.1f Mbit/s' % (rt.get('rx_mbit') or 0, rt.get('tx_mbit') or 0)],
                ['average 1 min', '↓ %.1f  ↑ %.1f' % (rt.get('avg_rx_1m') or 0, rt.get('avg_tx_1m') or 0)],
                ['average 1 h', '↓ %.1f  ↑ %.1f' % (rt.get('avg_rx_1h') or 0, rt.get('avg_tx_1h') or 0)],
                ['average 24 h', '↓ %.1f  ↑ %.1f' % (rt.get('avg_rx_24h') or 0, rt.get('avg_tx_24h') or 0)],
                ['peak 1 h', '↓ %.1f  ↑ %.1f' % (rt.get('peak_rx_1h') or 0, rt.get('peak_tx_1h') or 0)],
                ['peak 24 h', '↓ %.1f  ↑ %.1f' % (rt.get('peak_rx_24h') or 0, rt.get('peak_tx_24h') or 0)]]})
            S.append({'head': 'data used', 'rows': [
                ['today', '↓ %s  ↑ %s' % (gbs(rt.get('day_rx')), gbs(rt.get('day_tx')))],
                ['this month', '↓ %s  ↑ %s' % (gbs(rt.get('month_rx')), gbs(rt.get('month_tx')))],
                ['since router start', '↓ %s  ↑ %s' % (gbs(rt.get('rx_total')), gbs(rt.get('tx_total')))]]})
            S.append({'head': 'line', 'rows': [['WAN', 'up' if rt.get('wan_up') is not False else 'DOWN'],
                ['link rate', '%s / %s Mbit' % (rt.get('line_down', '–'), rt.get('line_up', '–'))],
                ['router uptime', dur(rt.get('uptime'))], ['ping gateway / internet', '%s / %s ms' % (rt.get('ping_gw', '–'), rt.get('ping_wan', '–'))],
                ['packet loss', '%s %%' % rt.get('loss_wan', '–')], ['firmware', str(rt.get('fw', '–'))]]})
        else:
            r = net.get('rate') or {}
            H = [['download', '%.1f' % (r.get('rx') or 0), 'Mbit/s'], ['upload', '%.1f' % (r.get('tx') or 0), 'Mbit/s']]
            S.append({'head': 'router', 'rows': [['status', 'no router data (gta2-router not set up)']]})
        C.append({'name': 'live · last 5 min (Mbit/s)', 'unit': 'Mbit/s', 'live': True,
                  'series': [{'c': '#2d89ef', 'pts': []}, {'c': '#e3a21a', 'pts': []}]})
        h = net.get('hist') or []
        if h: C.append({'name': 'tablet · last 3 h (Mbit/s)', 'unit': 'Mbit/s', 'series': [{'c': '#2d89ef', 'pts': [x[2] for x in h]}, {'c': '#e3a21a', 'pts': [x[3] for x in h]}]})
        S.append({'head': 'tablet interfaces', 'rows': [[i['name'] + ' · ' + i['kind'], '↓ %s  ↑ %s' % (gbs(i['rx']), gbs(i['tx']))] for i in netinfo()['ifs']]})
        out = net.get('outages') or []
        if out: S.append({'head': 'last outages', 'rows': [[time.strftime('%d %b %H:%M', time.localtime(o['start'])), '%d s' % (o['end'] - o['start'])] for o in out[-6:][::-1]]})
    elif k == 'lat':
        names, rows = net.get('tgt_names') or [], net.get('tgt') or []
        cur = net.get('lat') or {}
        H = [[n, '%.0f' % cur[n] if cur.get(n) is not None else '–', 'ms'] for n in ['router', '1.1.1.1', '8.8.8.8'] if n in cur]
        cols = ['#00aba9', '#2d89ef', '#e3a21a', '#9f00a7']
        if rows:
            C.append({'name': 'latency · last 3 h (ms)', 'unit': 'ms', 'series': [{'c': cols[j % 4], 'pts': [r[j + 1] for r in rows[::3]]} for j in range(len(names))]})
            for j, n in enumerate(names):
                st_ = lat_stats([r[j + 1] for r in rows])
                if not st_: continue
                S.append({'head': n, 'rows': [['average', '%.1f ms' % st_['avg'] if 'avg' in st_ else '–'], ['min / max', '%.1f / %.1f ms' % (st_['min'], st_['max']) if 'min' in st_ else '–'],
                                             ['jitter', '%.1f ms' % st_['jit'] if 'jit' in st_ else '–'], ['packet loss', '%.1f %%' % st_['loss']]]})
            S.append({'head': 'legend', 'rows': [[n, ['teal', 'blue', 'amber', 'purple'][j % 4]] for j, n in enumerate(names)]})
        else:
            h = net.get('hist') or []
            if h: C.append({'name': 'best latency · last 3 h (ms)', 'unit': 'ms', 'series': [{'c': '#2d89ef', 'pts': [x[1] for x in h]}]})
            S.append({'head': 'per target', 'rows': [['history', 'collecting… (starts after the update)']]})
    elif k == 'sp':
        sp = [x for x in (net.get('speed') or []) if x.get('down') is not None]
        if sp:
            l = sp[-1]
            H = [['download', '%.0f' % l['down'], 'Mbit/s'], ['upload', '%.0f' % (l.get('up') or 0), 'Mbit/s'], ['ping', '%.0f' % (l.get('ping') or 0), 'ms']]
            C.append({'name': 'all runs (Mbit/s)', 'unit': 'Mbit/s', 'series': [{'c': '#2d89ef', 'pts': [x['down'] for x in sp]}, {'c': '#e3a21a', 'pts': [x.get('up') or 0 for x in sp]}]})
            dn = [x['down'] for x in sp]
            S.append({'head': 'summary', 'rows': [['runs', str(len(sp))], ['download avg / best', '%.0f / %.0f Mbit/s' % (sum(dn) / len(dn), max(dn))],
                                                  ['last run', time.strftime('%d %b %H:%M', time.localtime(l['t']))], ['runs every', '15 min on Ethernet']]})
            S.append({'head': 'history', 'rows': [[time.strftime('%d %b %H:%M', time.localtime(x['t'])), '↓ %.0f  ↑ %.0f  · %s ms' % (x['down'], x.get('up') or 0, '%.0f' % x['ping'] if x.get('ping') else '–')] for x in sp[::-1][:24]]})
        A.append(['run speed test now', 'speedtest'])
    elif k == 'dev':
        hs = rt.get('hosts')
        H = [['online', str(rt.get('clients', '–')), 'devices']]
        if hs:
            on = [h for h in hs if h['on']]
            H.append(['known', str(len(hs)), ''])
            S.append({'head': 'online now', 'rows': [[h['name'] or 'unnamed', (h['ip'] + ('  · ' + h['if'] if h['if'] else ''))] for h in on]})
            off = [h for h in hs if not h['on']]
            if off: S.append({'head': 'seen before', 'rows': [[h['name'] or 'unnamed', h['ip']] for h in off[:20]]})
        else:
            S.append({'head': 'devices', 'rows': [['list', 'appears within a minute of the router update']]})
        pc = pistat('stats/top_clients?count=10').get('clients') or []
        if pc: S.append({'head': 'busiest on dns (pi-hole)', 'rows': [[c.get('name') or c.get('ip'), '%d queries' % c.get('count', 0)] for c in pc]})
    elif k in ('ph', 'phq'):
        p = pihole() or {}
        H = [['blocked', '%s' % p.get('percent', '–'), '%'], ['queries', str(p.get('total', '–')), ''], ['clients', str(p.get('clients', '–')), '']]
        hist = pistat('history').get('history') or []
        if hist: C.append({'name': 'queries · 24 h (blue total, red blocked)', 'unit': '', 'series': [{'c': '#2d89ef', 'pts': [x.get('total', 0) for x in hist]}, {'c': '#b91d47', 'pts': [x.get('blocked', 0) for x in hist]}]})
        S.append({'head': 'blocking', 'rows': [['blocked queries', str(p.get('blocked', '–'))], ['domains on blocklists', str(p.get('domains', '–'))]]})
        tb = pistat('stats/top_domains?blocked=true&count=10').get('domains') or []
        if tb: S.append({'head': 'top blocked', 'rows': [[d['domain'], str(d['count'])] for d in tb]})
        ta = pistat('stats/top_domains?count=10').get('domains') or []
        if ta: S.append({'head': 'top allowed', 'rows': [[d['domain'], str(d['count'])] for d in ta]})
        tc = pistat('stats/top_clients?count=10').get('clients') or []
        if tc: S.append({'head': 'top clients', 'rows': [[c.get('name') or c.get('ip'), str(c.get('count', 0))] for c in tc]})
        up = pistat('stats/upstreams').get('upstreams') or []
        if up: S.append({'head': 'answered by', 'rows': [[u.get('name') or u.get('ip'), str(u.get('count', 0))] for u in up]})
    elif k == 'cpu':
        def snap():
            r = {}
            for l in open('/proc/stat'):
                if l.startswith('cpu') and l[3].isdigit():
                    a = list(map(int, l.split()[1:])); r[l.split()[0]] = (a[3] + a[4], sum(a))
            return r
        s0 = snap(); time.sleep(0.25); s1 = snap()
        use = {c: round(100 * (1 - (s1[c][0] - s0[c][0]) / max(1, s1[c][1] - s0[c][1]))) for c in s1}
        cores = sorted(use, key=lambda c: int(c[3:]))
        tot = round(sum(use.values()) / max(1, len(use)))
        temps = []
        for z in sorted(glob.glob('/sys/class/thermal/thermal_zone*')):
            t = rd(z + '/temp', '')
            if t.lstrip('-').isdigit(): temps.append([rd(z + '/type'), '%.1f °C' % (int(t) / 1000)])
        H = [['usage', str(tot), '%'], ['temp', temps[0][1].split()[0] if temps else '–', '°C'], ['load', rd('/proc/loadavg').split()[0], '']]
        S.append({'head': 'cores', 'rows': [[c, '%d %% · %d MHz' % (use[c], int(rd('/sys/devices/system/cpu/%s/cpufreq/scaling_cur_freq' % c, '0') or 0) // 1000)] for c in cores]})
        pol = '/sys/devices/system/cpu/cpufreq/policy0/'
        S.append({'head': 'clock', 'rows': [['governor', rd(pol + 'scaling_governor')], ['range', '%d–%d MHz' % (int(rd(pol + 'scaling_min_freq', '0') or 0) // 1000, int(rd(pol + 'scaling_max_freq', '0') or 0) // 1000)],
                                            ['gpu', '%d MHz' % (int(rd('/sys/class/devfreq/11400000.gpu/cur_freq', '0') or 0) // 1000000)], ['load 1/5/15 min', ' '.join(rd('/proc/loadavg').split()[:3])]]})
        if temps: S.append({'head': 'temperatures', 'rows': temps})
        S.append({'head': 'top processes', 'rows': ps_top('pcpu')})
    elif k == 'mem':
        m = {l.split(':')[0]: int(l.split()[1]) // 1024 for l in open('/proc/meminfo')}
        used = m['MemTotal'] - m['MemAvailable']
        H = [['used', '%.1f' % (used / 1024), 'GB'], ['free', '%.1f' % (m['MemAvailable'] / 1024), 'GB'], ['swap used', '%d' % (m['SwapTotal'] - m['SwapFree']), 'MB']]
        S.append({'head': 'memory', 'rows': [['total', '%d MB' % m['MemTotal']], ['in use by programs', '%d MB' % used], ['cache (freed when needed)', '%d MB' % (m.get('Cached', 0) + m.get('Buffers', 0))],
                                             ['completely free', '%d MB' % m['MemFree']], ['shared', '%d MB' % m.get('Shmem', 0)]]})
        z = rd('/sys/block/zram0/mm_stat').split()
        if z:
            S.append({'head': 'zram (compressed swap in RAM)', 'rows': [['size', '%d MB' % (int(rd('/sys/block/zram0/disksize', '0')) >> 20)], ['stored', '%d MB' % (int(z[0]) >> 20)],
                     ['takes', '%d MB' % (int(z[2]) >> 20)], ['ratio', '%.1f×' % (int(z[0]) / max(1, int(z[1])))], ['algorithm', rd('/sys/block/zram0/comp_algorithm').split('[')[-1].split(']')[0]]]})
        S.append({'head': 'top processes (memory)', 'rows': ps_top('rss')})
    elif k == 'bat':
        def ue(p):
            d = {}
            for l in rd(p + '/uevent').splitlines():
                if '=' in l: a, b = l.split('=', 1); d[a.replace('POWER_SUPPLY_', '').lower()] = b
            return d
        fg = ue((glob.glob('/sys/class/power_supply/*fuel*') or [''])[0]); ch = ue((glob.glob('/sys/class/power_supply/*charger*') or [''])[0])
        num = lambda d, key, div: (int(d[key]) / div) if d.get(key, '').lstrip('-').isdigit() else None
        cap, cur, vol, tmp = fg.get('capacity'), num(fg, 'current_now', 1000), num(fg, 'voltage_now', 1e6), num(fg, 'temp', 10)
        H = [['charge', cap or '–', '%'], ['current', '%.0f' % cur if cur is not None else '–', 'mA'], ['temp', '%.1f' % tmp if tmp is not None else '–', '°C']]
        rows = [['status', fg.get('status', '–').lower()], ['charger', 'connected' if ch.get('online') == '1' else 'not connected'],
                ['charging', ch.get('status', '–').lower()], ['charge limit', '%s %%' % rd('/etc/gta2/charge_limit', '100')]]
        if vol: rows.append(['voltage', '%.2f V' % vol])
        if vol and cur is not None: rows.append(['power', '%.1f W' % (vol * cur / 1000)])
        if fg.get('charge_full_design'): rows.append(['design capacity', '%d mAh' % (int(fg['charge_full_design']) // 1000)])
        for key, lab in (('health', 'health'), ('charge_type', 'charge type'), ('constant_charge_current', 'charge current'), ('technology', 'technology')):
            v = ch.get(key) or fg.get(key)
            if v: rows.append([lab, (str(int(v) // 1000) + ' mA') if key == 'constant_charge_current' and v.isdigit() else v.lower()])
        S.append({'head': 'battery', 'rows': rows})
    elif k == 'disk':
        rows = []
        for l in sh("df -B1 --output=target,size,used,avail -x tmpfs -x devtmpfs -x overlay -x squashfs -x efivarfs 2>/dev/null | tail -n +2").splitlines():
            p = l.split()
            if len(p) == 4 and not p[0].startswith(('/var/lib/docker', '/snap', '/run')): rows.append([p[0], '%s free of %s' % (gbs(int(p[3])), gbs(int(p[1])))])
        big = [d for d in api_disks()]
        H = [[d['name'].lower(), '%.0f' % (d['total'] - d['used']), 'GB free'] for d in big[:3]]
        S.append({'head': 'mounted', 'rows': rows})
        dd = DOCKER_DF.get()
        if dd: S.append({'head': 'docker', 'rows': dd})
        S.append({'head': 'share drive', 'rows': [['NAS share', SHARE + (' (mounted)' if os.path.ismount(SHARE) else ' (500 GB drive not connected)')]]})
    elif k == 'wifi':
        ni = netinfo(); w = ni.get('wifi') or {}
        eth = [i for i in ni['ifs'] if i['kind'] == 'ethernet' and i['ip']]
        H = [['ethernet', str(eth[0]['speed']) if eth and eth[0]['speed'] else '–', 'Mbit'], ['wi-fi', str(w.get('signal', '–')), '%']]
        S.append({'head': 'interfaces', 'rows': [[i['name'] + ' · ' + i['kind'], (i['ip'] or 'no address') + (' · %d Mbit' % i['speed'] if i['speed'] else '')] for i in ni['ifs']]})
        if w: S.append({'head': 'wi-fi', 'rows': [['network', w.get('ssid', '')], ['signal', '%s %%' % w.get('signal')], ['band', w.get('freq', '')], ['rate', w.get('rate', '')], ['security', w.get('sec', '')]]})
        dns = [l.split()[1] for l in rd('/run/systemd/resolve/resolv.conf').splitlines() if l.startswith('nameserver')]
        ts = sh('tailscale ip -4 2>/dev/null')
        S.append({'head': 'routing', 'rows': [['gateway', ni.get('gw') or '–'], ['dns servers', ' '.join(dns) or '–'], ['tailscale', ts or 'off'], ['host name', socket.gethostname()]]})
    elif k == 'up':
        up = float(rd('/proc/uptime', '0').split()[0])
        H = [['up', dur(up).split()[0], ' '.join(dur(up).split()[1:])], ['time', time.strftime('%H:%M'), '']]
        S.append({'head': 'system', 'rows': [['date', time.strftime('%A %d %B %Y')], ['time zone', time.strftime('%Z (UTC%z)')], ['booted', time.strftime('%d %b %H:%M', time.localtime(time.time() - up))],
                                             ['os', sh('. /etc/os-release; echo $PRETTY_NAME')], ['kernel', os.uname().release], ['host name', socket.gethostname()]]})
    elif k == 'ctr':
        rows = []
        for l in sh("docker ps -a --format '{{.Names}}|{{.Status}}|{{.Image}}' 2>/dev/null").splitlines():
            p = (l.split('|') + ['', ''])[:3]; rows.append([p[0], p[1] + ' · ' + p[2].split('/')[-1][:28]])
        H = [['running', str(len([r for r in rows if r[1].startswith('Up')])), ''], ['total', str(len(rows)), '']]
        S.append({'head': 'containers', 'rows': rows or [['docker', 'no containers']]})
        dd = DOCKER_DF.get()
        if dd: S.append({'head': 'docker disk use', 'rows': dd})
        A.append(['open portainer', 'open:http://127.0.0.1:9000/'])
    return {'hero': H, 'charts': C, 'sections': S, 'actions': A}


def api_disks():
    out = []
    for name, path in (('Share drive', SHARE), ('Data', '/userdata'), ('System', '/')):
        if path == SHARE and not os.path.ismount(path): continue
        try:
            s = os.statvfs(path); t = s.f_blocks * s.f_frsize; f = s.f_bavail * s.f_frsize
            out.append({'name': name, 'used': (t - f) / 2**30, 'total': t / 2**30})
        except OSError: pass
    return out


class _DockerDF:  # `docker system df` takes ~1 s: cache it for 2 min in /run
    P = '/run/gta2/dockerdf.json'
    def get(self):
        try:
            if time.time() - os.path.getmtime(self.P) < 120: return json.load(open(self.P))
        except OSError: pass
        rows = []
        for l in sh("docker system df --format '{{.Type}}|{{.Size}}|{{.Reclaimable}}' 2>/dev/null").splitlines():
            p = (l.split('|') + ['', ''])[:3]; rows.append([p[0].lower(), '%s · %s reclaimable' % (p[1], p[2].split(' ')[0])])
        try: json.dump(rows, open(self.P, 'w'))
        except OSError: pass
        return rows
DOCKER_DF = _DockerDF()


def wallpaper():
    for ext in ('jpg', 'jpeg', 'png', 'webp'):
        for p in (f'{SHARE}/wallpaper.{ext}', f'{SHARE}/Wallpaper.{ext}'):
            if os.path.isfile(p): return p
    return None


