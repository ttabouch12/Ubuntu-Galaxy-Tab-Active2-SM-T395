<script>
/* gta2 router cards (add-on). Fetches /api router block, renders 4 cards in the Internet section.
   Uses page helper card(k,v,s,pct,col) or st2(k,v,sub,col,frac) when global, else own markup. */
(function () {
  var ID = 'gta2-router-cards';
  var hist = [];
  function api() {
    var h = location.port === '8088' ? '' : 'http://' + location.hostname + ':8088';
    return fetch(h + '/api', { cache: 'no-store' }).then(function (r) { return r.json(); });
  }
  function dur(s) {
    if (s == null) return '\u2013';
    var d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
    return d ? d + 'd ' + h + 'h' : h ? h + 'h ' + m + 'm' : m + 'm';
  }
  function gb(b) { if (b == null) return '\u2013'; return b >= 1e12 ? (b / 1e12).toFixed(2) + ' TB' : b >= 1e9 ? (b / 1e9).toFixed(1) + ' GB' : (b / 1e6).toFixed(0) + ' MB'; }
  function f(x) { return x == null ? '\u2013' : (x >= 100 ? x.toFixed(0) : x.toFixed(1)); }
  function spark(col) {
    if (hist.length < 2) return '';
    var max = Math.max.apply(null, hist.concat([1])), w = 120, h = 24;
    var pts = hist.map(function (v, i) { return (i * w / (hist.length - 1)).toFixed(1) + ',' + (h - v / max * h).toFixed(1); }).join(' ');
    return '<svg width="' + w + '" height="' + h + '" style="display:block;margin-top:4px"><polyline fill="none" stroke="' + col + '" stroke-width="1.5" points="' + pts + '"/></svg>';
  }
  function own(k, v, s, col, frac) {
    return '<div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:10px 12px;min-width:150px;flex:1">' +
      '<div style="font-size:12px;opacity:.7">' + k + '</div>' +
      '<div style="font-size:20px;font-weight:600;color:' + col + '">' + v + '</div>' +
      '<div style="font-size:11px;opacity:.6">' + (s || '') + '</div>' +
      (frac != null ? '<div style="height:3px;background:rgba(255,255,255,.08);border-radius:2px;margin-top:6px"><div style="height:3px;width:' + Math.min(100, frac * 100) + '%;background:' + col + ';border-radius:2px"></div></div>' : '') +
      '</div>';
  }
  function mk(k, v, s, col, frac) {
    try {
      if (typeof card === 'function') return card(k, v, s, frac == null ? null : frac * 100, col);
      if (typeof st2 === 'function') return st2(k, v, s, col, frac);
    } catch (e) {}
    return own(k, v, s, col, frac);
  }
  function anchor() {
    var els = document.querySelectorAll('h1,h2,h3,h4,.sec,.section-title,.title,summary,div,span');
    for (var i = 0; i < els.length; i++) {
      var e = els[i];
      if (e.children.length === 0 && /^\s*internet\s*$/i.test(e.textContent)) return e;
    }
    return null;
  }
  function place() {
    var box = document.getElementById(ID);
    if (box && document.body.contains(box)) return box;
    box = document.createElement('div');
    box.id = ID;
    box.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;margin:8px 0';
    var a = anchor();
    if (a) {
      var sib = a.nextElementSibling;
      (sib && sib.parentNode ? sib.parentNode.insertBefore(box, sib.nextSibling) : a.parentNode.insertBefore(box, a.nextSibling));
    } else document.body.appendChild(box);
    return box;
  }
  function render(r) {
    var box = place();
    if (!r) { box.innerHTML = mk('Router', 'no data', 'gta2-router not running', '#8e9aaf'); return; }
    if (!r.ok) { box.innerHTML = mk('Router', 'error', r.error || '', '#f87171'); return; }
    var stale = Date.now() / 1000 - (r.t || 0) > 90 ? ' (stale)' : '';
    if (r.rx_mbit != null) { hist.push(r.rx_mbit); if (hist.length > 60) hist.shift(); }
    var ld = r.line_down, lu = r.line_up, D = '\u2193 ', U = ' / \u2191 ';
    var lat = r.ping_wan == null ? '\u2013' : r.ping_wan.toFixed(1) + ' ms';
    var latCol = r.ping_wan == null ? '#f87171' : r.ping_wan < 30 ? '#34d399' : r.ping_wan < 80 ? '#fbbf24' : '#f87171';
    box.innerHTML =
      mk('Home traffic (router)', D + f(r.rx_mbit) + U + f(r.tx_mbit),
         'Mbit/s' + stale + ' \u00b7 1h avg ' + D + f(r.avg_rx_1h) + U + f(r.avg_tx_1h) +
         ' \u00b7 24h peak ' + D + f(r.peak_rx_24h) + U + f(r.peak_tx_24h) + spark('#22d3ee'),
         '#22d3ee', ld ? (r.rx_mbit || 0) / ld : null) +
      mk('Data today', D + gb(r.day_rx) + U + gb(r.day_tx),
         'month ' + D + gb(r.month_rx) + U + gb(r.month_tx) + ' \u00b7 since router boot ' + D + gb(r.rx_total) + U + gb(r.tx_total),
         '#f472b6', null) +
      mk('Latency (via router)', lat,
         (r.ping_host || 'internet') + ' \u00b7 router hop ' + (r.ping_gw == null ? '\u2013' : r.ping_gw.toFixed(1) + ' ms') +
         ' \u00b7 loss ' + (r.loss_wan == null ? '\u2013' : r.loss_wan.toFixed(0) + '%'),
         latCol, null) +
      mk('Devices online', r.clients == null ? '\u2013' : String(r.clients), r.wan_up === false ? 'WAN DOWN' : 'WAN up', '#a78bfa', null) +
      mk('Router uptime', dur(r.uptime), r.fw || '', '#8e9aaf', null) +
      mk('Line rate', ld ? ld + ' / ' + lu : '\u2013', 'Mbit/s down / up', '#34d399', null);
  }
  function tick() { api().then(function (j) { render(j.router); }).catch(function () {}); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tick); else setTimeout(tick, 500);
  setInterval(tick, 5000);
})();

</script></body></html>'''


HOME = '/usr/share/gta2/home/index.html'   # unified UI (tablet screen + LAN); old page at /classic


def peer_local():  # control endpoints only for the tablet's own kiosk, never the LAN
    try:
        return socket.socket(fileno=os.dup(0)).getpeername()[0] in ('127.0.0.1', '::1', '::ffff:127.0.0.1')
    except OSError:
        return False


def x(cmd):  # start a program in the tablet's X session as the gta2 user.
    # Own transient unit: this request's service (socket activation) is killed when the request ends,
    # and with it anything started directly from here.
    subprocess.Popen(['systemd-run', '--quiet', '--collect', '--uid=gta2', '--gid=gta2', '--setenv=DISPLAY=:0',
                      '--setenv=HOME=/home/gta2', '--setenv=XDG_RUNTIME_DIR=/run/user/1000', 'sh', '-c', cmd],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


UICFG = '/home/gta2/.config/gta2/ui.json'   # read by gta2-keys (screen timeout)
CTL_AREAS = {'time', 'device', 'update', 'cpu', 'bt', 'battery', 'ssh', 'vpn', 'hotspot', 'docker'}


def run(argv, t=60):  # argv list, never a shell: values typed on the page cannot inject commands
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=t)
        return (r.stdout + r.stderr).strip()
    except subprocess.TimeoutExpired:
        return 'error: timed out'
    except Exception as e:
        return 'error: %s' % e


def kv(t):
    return dict(x.split('=', 1) for x in t.split() if '=' in x)


def uicfg(upd=None):
    try: c = json.load(open(UICFG))
    except Exception: c = {}
    c.setdefault('screen_off', 0)
    if upd:
        c.update(upd); os.makedirs(os.path.dirname(UICFG), exist_ok=True)
        json.dump(c, open(UICFG, 'w')); os.system('chown -R gta2:gta2 /home/gta2/.config/gta2')
    return c


def status():  # everything the Settings page shows, in one call
    st = {k: kv(run(['/usr/local/sbin/gta2-ctl', k, 'status'], 15)) for k in ('cpu', 'ssh', 'hotspot', 'time')}
    st['vpn'] = run(['/usr/local/sbin/gta2-ctl', 'vpn', 'status'], 15)
    st['battery'] = run(['/usr/local/sbin/gta2-ctl', 'battery', 'status'], 15)
    st['charge_limit'] = int(rd('/etc/gta2/charge_limit', '100') or 100)
    bt = run(['/usr/local/sbin/gta2-ctl', 'bt', 'status'], 15)
    st['bt'] = {'on': 'Powered: yes' in bt, 'text': bt}
    st['share'] = dict(l.split('=', 1) for l in run(['/usr/local/sbin/gta2-share', 'status'], 15).splitlines() if '=' in l)
    st['wifi_on'] = 'enabled' in run(['nmcli', 'radio', 'wifi'], 10)
    st['time']['now'] = time.strftime('%Y-%m-%d %H:%M')
    st['navbar'] = not os.path.exists('/home/gta2/.config/gta2/nonavbar')
    st['kbd'] = 'classic' if os.path.exists('/home/gta2/.config/gta2/kbd_classic') else 'metro'
    st['ui'] = uicfg(); st['host'] = socket.gethostname()
    st['os'] = sh(". /etc/os-release; echo $PRETTY_NAME"); st['kernel'] = os.uname().release
    st['space'] = sh("df -h / /userdata | awk 'NR>1{print $6\"  \"$4\" free of \"$2}'")
    return st


def wifi_scan():
    run(['nmcli', 'dev', 'wifi', 'rescan'], 15); time.sleep(2)
    out, seen = [], set()
    for l in run(['nmcli', '-t', '-f', 'IN-USE,SSID,SIGNAL,SECURITY', 'dev', 'wifi', 'list'], 20).splitlines():
        p = [x.replace('\x00', ':') for x in l.replace('\\:', '\x00').split(':')] + ['', '', '', '']
        if not p[1] or p[1] in seen: continue
        seen.add(p[1]); out.append({'on': p[0] == '*', 'ssid': p[1], 'signal': int(p[2] or 0), 'sec': p[3]})
    saved = run(['nmcli', '-t', '-f', 'NAME,TYPE', 'con', 'show'], 10)
    known = {l.rsplit(':', 1)[0] for l in saved.splitlines() if l.endswith('wireless')}
    for w in out: w['saved'] = w['ssid'] in known
    return sorted(out, key=lambda w: (not w['on'], -w['signal']))


def kbd(op):  # K2KBD: Windows Phone keyboard (gta2-kbd, always running); matchbox-keyboard if classic/unavailable
    try:
        import urllib.request
        urllib.request.urlopen('http://127.0.0.1:8097/' + op, timeout=1).read(); return
    except Exception:
        pass
    x({'toggle': 'pkill -x matchbox-keyboa || matchbox-keyboard', 'show': 'pgrep -x matchbox-keyboa >/dev/null || matchbox-keyboard',
       'hide': 'pkill -x matchbox-keyboa'}[op])


def ctl(a, v):
    if a in ('launch', 'uninstall', 'apps_job'):
        return gta2apps.ctl(a, v) if gta2apps else None
    if a in ('yt_play', 'yt_sub', 'yt_hist_clear'):   # YouTube app (gta2yt.py)
        sys.path.insert(0, '/usr/local/lib/gta2'); import gta2yt
        return gta2yt.ctl(a, v, x)
    if a == 'youtube': x('/usr/local/bin/gta2-youtube'); return {'ok': True}
    if a in ('storage', 'store_job', 'docker_move', 'app_storage', 'app_move'):   # external drive for apps (gta2store.py)
        sys.path.insert(0, '/usr/local/lib/gta2'); import gta2store
        return gta2store.ctl(a, v)
    bl = (glob.glob('/sys/class/backlight/*') or [''])[0]
    v = v if v is not None else ''
    if a == 'info':
        return {'bright': int(rd(bl + '/brightness', '0') or 0), 'max': int(rd(bl + '/max_brightness', '255') or 255)}
    if a == 'status': return status()
    if a == 'bright':
        open(bl + '/brightness', 'w').write(str(max(5, int(v))))
    elif a == 'rotate':  # SRROT normal|left|right|inverted (turns auto-rotate off) or auto_on|auto_off
        if v in ('auto_on', 'auto_off'): return {'ok': True, 'ui': uicfg({'autorotate': v == 'auto_on'})}
        if v not in ('normal', 'left', 'right', 'inverted'): return None
        uicfg({'autorotate': False}); x('gta2-rotate set %s' % v)
    elif a == 'volkeys':  # VOL keys: auto (volume when a real audio output exists) | volume | brightness
        if v not in ('auto', 'volume', 'brightness'): return None
        return {'ok': True, 'ui': uicfg({'volkeys': v})}
    elif a == 'screenoff': x('gta2-keys --screen-off')
    elif a == 'keyboard': kbd('toggle')
    elif a == 'navbar':  # on-screen back/home/keyboard bar (gta2-navbar); flag file hides it
        p = '/home/gta2/.config/gta2/nonavbar'
        if v == 'off':
            open(p, 'w').close(); subprocess.call(['pkill', '-f', 'home-qml/Navbar.qml'])
        else:
            if os.path.exists(p): os.remove(p)
            if subprocess.call(['pgrep', '-f', 'home-qml/Navbar.qml'], stdout=subprocess.DEVNULL) != 0: x('gta2-navbar')
    elif a == 'pins':  # home-screen pins: no value = read, list = save (ids/names/icon URLs only)
        p = '/home/gta2/.config/gta2/pins.json'
        if isinstance(v, list):
            clean = [{'id': str(i.get('id', ''))[:80], 'name': str(i.get('name', ''))[:60], 'icon': str(i.get('icon', ''))[:300]}
                     for i in v[:48] if isinstance(i, dict) and i.get('id')]
            os.makedirs(os.path.dirname(p), exist_ok=True); json.dump(clean, open(p, 'w')); os.system('chown gta2:gta2 ' + p)
            return {'ok': True}
        try: return {'ok': True, 'pins': json.load(open(p))}
        except Exception: return {'ok': True, 'pins': []}
    elif a == 'kbd_show': kbd('show')
    elif a == 'kbd_hide': kbd('hide')
    elif a == 'kbd_mode':  # metro | classic
        p = '/home/gta2/.config/gta2/kbd_classic'
        if v == 'classic': open(p, 'w').close()
        elif os.path.exists(p): os.remove(p)
        os.system('pkill -f gta2kbd.py; pkill -x matchbox-keyboa')
        return {'ok': True, 'mode': 'classic' if os.path.exists(p) else 'metro'}
    elif a == 'open':  # open one of the tablet's own web services full screen (HOME closes it)
        u = str(v)
        if not u.startswith(('http://127.0.0.1', 'http://localhost')) or any(c in u for c in '\'"`$\\ ;&|<>'): return None
        x("WEBKIT_DISABLE_COMPOSITING_MODE=1 surf -F '%s'" % u)
    elif a == 'webhome':  # web (surf) home instead of the native one on the tablet screen
        p = '/home/gta2/.config/gta2/webhome'
        if v == 'on': open(p, 'w').close(); os.system('chown gta2:gta2 ' + p)
        elif os.path.exists(p): os.remove(p)
        subprocess.Popen(['systemctl', 'restart', 'gta2-gui'])
    elif a == 'terminal': x("xterm -fa 'DejaVu Sans Mono' -fs 13 -bg '#0b0e14' -fg '#e6edf3' -e bash -l"); kbd('show')
    elif a == 'vnc':
        hp = ''.join(c for c in str(v) if c.isalnum() or c in '.:-')
        if not hp: return None
        x('vncviewer -FullScreen %s' % hp)
    elif a == 'moonlight': x('QT_QPA_PLATFORM=xcb QT_XCB_GL_INTEGRATION=xcb_egl moonlight-qt')
    elif a == 'desktop':  # desktop mode for the USB-C dock (IceWM, landscape); restarts X
        subprocess.Popen(['/usr/local/bin/gta2-desktop', 'on', v if v in ('left', 'right', 'normal') else 'left'])
    elif a == 'reboot': subprocess.Popen(['systemctl', 'reboot'])
    elif a == 'poweroff': subprocess.Popen(['systemctl', 'poweroff'])
    elif a == 'restart-ui': subprocess.Popen(['systemctl', 'restart', 'gta2-gui'])
    elif a == 'classic':  # opt back into the old Tk launcher (Settings > Interface)
        p = '/home/gta2/.config/gta2/classic'
        if v == 'on': open(p, 'w').close()
        elif os.path.exists(p): os.remove(p)
        subprocess.Popen(['systemctl', 'restart', 'gta2-gui'])
    elif a == 'ui': return {'ok': True, 'ui': uicfg({'screen_off': max(0, min(240, int(v)))})}
    elif a == 'sys':  # gta2-ctl <area> <action> [args]: same root helper the old Settings app used
        args = [str(x) for x in (v if isinstance(v, list) else [])][:4]
        if not args or args[0] not in CTL_AREAS: return None
        return {'ok': True, 'out': run(['/usr/local/sbin/gta2-ctl'] + args, 600)}
    elif a == 'share':
        args = [str(x) for x in (v if isinstance(v, list) else [])][:2]
        if not args or args[0] not in ('smb', 'guest', 'passwd', 'status'): return None
        return {'ok': True, 'out': run(['/usr/local/sbin/gta2-share'] + args, 60)}
    elif a == 'fpslog': open('/tmp/gta2-fps.log', 'a').write(time.strftime('%H:%M:%S ') + str(v)[:120] + '\n')
    elif a == 'wifi_scan': return {'ok': True, 'list': wifi_scan()}
    elif a == 'wifi_radio': return {'ok': True, 'out': run(['nmcli', 'radio', 'wifi', 'on' if v == 'on' else 'off'])}
    elif a == 'wifi_connect':
        ssid, pw = str(v.get('ssid', '')), str(v.get('pw', ''))
        if not ssid: return None
        return {'ok': True, 'out': run(['nmcli', 'dev', 'wifi', 'connect', ssid] + (['password', pw] if pw else []), 60)}
    elif a == 'wifi_forget': return {'ok': True, 'out': run(['nmcli', 'con', 'delete', str(v)])}
    else: return None
    return {'ok': True}


try:
    req = sys.stdin.readline().split()
    hdr = {}
    while True:
        l = sys.stdin.readline()
        if not l or l in ('\r\n', '\n'): break
        k, _, val = l.partition(':'); hdr[k.strip().lower()] = val.strip()
except Exception:
    req, hdr = [], {}
meth, path = (req + ['GET', '/'])[:2]
import urllib.parse
query = urllib.parse.parse_qs(path.split('?', 1)[1]) if '?' in path else {}
path = path.split('?')[0]
# GTA2APPS: desktop apps for the home screen (/apps, /icon, /apps/job) - /usr/local/lib/gta2/gta2apps.py
try:
    sys.path.insert(0, '/usr/local/lib/gta2'); import gta2apps
except Exception:
    gta2apps = None
try:
    import gta2yt   # YouTube app: GET /yt (read-only)
except Exception:
    gta2yt = None
if gta2apps and gta2apps.handle(meth, path, query, send):
    pass
elif gta2yt and gta2yt.handle(meth, path, query, send):
    pass
elif path == '/ctl' and meth == 'POST':
    try:
        body = json.loads(sys.stdin.read(int(hdr.get('content-length', '0') or 0)) or '{}')
        res = ctl(body.get('a'), body.get('v')) if peer_local() else None
    except Exception:
        res = None
    if res is None: send('403 Forbidden', 'text/plain', 'no')
    else: send('200 OK', 'application/json', json.dumps(res))
elif path == '/classic':
    send('200 OK', 'text/html; charset=utf-8', PAGE)
elif path in ('/', '/index.html') and os.path.exists(HOME):
    send('200 OK', 'text/html; charset=utf-8', open(HOME, 'rb').read())
elif path == '/live':   # cheap: just the two daemon files, for the 2 s refresh
    out = {}
    for k, f in (('net', '/run/gta2/netmon.json'), ('router', '/run/gta2/router.json')):
        try: out[k] = json.load(open(f))
        except Exception: out[k] = None
    if out['net']: out['net'].pop('hist', None); out['net'].pop('speed', None); out['net'].pop('tgt', None)
    if out['router']: out['router'].pop('hosts', None)
    send('200 OK', 'application/json', json.dumps(out), 'Access-Control-Allow-Origin: *\r\n')
elif path == '/detail':   # read-only breakdown for one home tile (key validated against DETAIL_KEYS)
    k = (query.get('k') or [''])[0]
    if k in DETAIL_KEYS:
        try: send('200 OK', 'application/json', json.dumps(detail(k)), 'Access-Control-Allow-Origin: *\r\n')
        except Exception as e: send('500 Error', 'application/json', json.dumps({'error': str(e)[:200]}))
    else: send('404 Not Found', 'text/plain', 'unknown')
elif path == '/api':
    send('200 OK', 'application/json', json.dumps(api()), 'Access-Control-Allow-Origin: *\r\n')
elif path == '/wallpaper':
    p = wallpaper()
    if p:
        ct = {'png': 'image/png', 'webp': 'image/webp'}.get(p.rsplit('.', 1)[-1].lower(), 'image/jpeg')
        send('200 OK', ct, open(p, 'rb').read(), 'Cache-Control: max-age=300\r\n')
    else:
        send('404 Not Found', 'text/plain', 'no wallpaper')
elif path == '/speedtest' and meth == 'POST':
    try: open('/run/gta2/speedtest.now', 'w').close(); send('200 OK', 'text/plain', 'ok')
    except OSError: send('500 Error', 'text/plain', 'netmon not running')
else:
    send('200 OK', 'text/html; charset=utf-8', PAGE)
