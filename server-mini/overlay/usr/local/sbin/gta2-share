#!/bin/sh
# gta2-share: file sharing control (root). Share folder: /userdata/gta2srv/share (survives reflashing the rootfs)
#   gta2-share status | smb on|off | guest on|off | passwd <pw> | init
S=/userdata/gta2srv/share
C=/etc/samba/smb.conf
G=/etc/samba/gta2-guest
gen() {
  if [ -f $G ]; then GU='guest ok = yes'; else GU='guest ok = no'; fi
  cat > $C <<EOF
# generated by gta2-share v2 (Settings > Files). Edit gta2-share, not this file.
[global]
   workgroup = WORKGROUP
   server string = gta2srv
   server role = standalone server
   map to guest = Bad User
   guest account = gta2
   disable netbios = yes
   smb ports = 445
   server min protocol = SMB2
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log level = 0
   max log size = 50
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   use sendfile = yes
[share]
   comment = Galaxy Tab Active2 files
   path = $S
   read only = no
   browseable = yes
   $GU
   force user = gta2
   force group = gta2
   create mask = 0664
   directory mask = 0775
[sdcard]
   comment = microSD card (mounted at /media/sdcard when a card is inserted)
   path = /media/sdcard
   read only = no
   browseable = yes
   $GU
   force user = gta2
   force group = gta2
   create mask = 0664
   directory mask = 0775
EOF
}
init() {
  mkdir -p $S/Screensaver $S/Downloads; chown 1000:1000 $S $S/Screensaver $S/Downloads
  [ -e /home/gta2/Share ] || ln -s $S /home/gta2/Share
  [ -f $C ] && grep -q 'gta2-share v2' $C || gen
  pdbedit -L 2>/dev/null | grep -q '^gta2:' || { printf 'gta2\ngta2\n' | smbpasswd -s -a gta2 >/dev/null; }
}
case "$1" in
  init) init ;;
  status) printf 'smb=%s\nguest=%s\ngta2-wsdd=%s\n' "$(systemctl is-active smbd)" "$([ -f $G ] && echo on || echo off)" "$(systemctl is-active gta2-wsdd 2>/dev/null)" ;;
  smb) init
       if [ "$2" = on ]; then systemctl enable --now smbd >/dev/null 2>&1; systemctl enable --now gta2-wsdd >/dev/null 2>&1; echo 'SMB on'
       else systemctl disable --now smbd gta2-wsdd >/dev/null 2>&1; echo 'SMB off'; fi ;;
  guest) if [ "$2" = on ]; then touch $G; else rm -f $G; fi; gen; systemctl try-reload-or-restart smbd >/dev/null 2>&1; echo "guest $2" ;;
  passwd) [ -n "$2" ] || exit 1; init; printf '%s\n%s\n' "$2" "$2" | smbpasswd -s -a gta2 >/dev/null && smbpasswd -e gta2 >/dev/null && echo changed ;;
  *) echo "usage: $0 status|smb on|off|guest on|off|passwd PW|init"; exit 1 ;;
esac
