#!/bin/sh
# gta2srv PID1 wrapper. On the Samsung 3.18 kernel: the bootloader ignores the boot.img cmdline, so hand systemd
# extra args via SYSTEMD_PROC_CMDLINE -> cgroup v1 (the backported cgroup2 lacks BPF device control, runc needs it).
# On the mainline kernel nothing is changed (cgroup v2).
case "$(uname -r)" in 3.*)
  export SYSTEMD_PROC_CMDLINE="$(cat /proc/cmdline) systemd.unified_cgroup_hierarchy=0 SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1";;
esac
exec /usr/lib/systemd/systemd "$@"
