 arch/arm64/boot/dts/exynos/Makefile           |   1 +
 .../dts/exynos/exynos7870-gtactive2lte.dts    | 745 ++++++++++++++++++
 3 files changed, 747 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos7870-gtactive2lte.dts

