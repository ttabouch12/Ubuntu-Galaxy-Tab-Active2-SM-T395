+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/st,fts8.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics FingerTip FTS8 touchscreen controller
+
+maintainers:
+  - Dmitry Torokhov <dmitry.torokhov@gmail.com>
+
+description:
+  The FTS8 generation of ST FingerTip capacitive touchscreen controllers,
+  e.g. the fts8cd56 used in the Samsung Galaxy Tab Active2.
+
+allOf:
+  - $ref: touchscreen.yaml#
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - const: st,fts8cd56
+          - const: st,fts8
+      - const: st,fts8
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  avdd-supply:
+    description: Analog power supply (3.3 V)
+
+  vdd-supply:
+    description: Digital/IO power supply (1.8 V)
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@49 {
+            compatible = "st,fts8cd56", "st,fts8";
+            reg = <0x49>;
+            interrupt-parent = <&gpd1>;
+            interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
+            avdd-supply = <&tsp_avdd>;
+            vdd-supply = <&vdd_ldo32>;
+            touchscreen-size-x = <1600>;
+            touchscreen-size-y = <2560>;
+        };
+    };
