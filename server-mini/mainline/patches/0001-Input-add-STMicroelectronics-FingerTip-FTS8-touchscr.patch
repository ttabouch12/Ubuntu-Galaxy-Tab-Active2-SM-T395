@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * STMicroelectronics FingerTip FTS8 (fts8cd56) touchscreen driver
+ *
+ * Minimal driver for the FTS8 generation of ST FingerTip controllers as
+ * found e.g. in the Samsung Galaxy Tab Active2 (SM-T395). The protocol was
+ * derived from the GPL-2.0 Samsung vendor driver (fts_ts.c). Compared to
+ * the FTS4 devices handled by stmfts.c, FTS8 uses register writes through
+ * the 0xb6 "hardware register" window for system reset and interrupt
+ * enable, and exposes the event FIFO depth in a register.
+ *
+ * Firmware update, factory test commands, hover, glove, palm and gesture
+ * features of the vendor driver are intentionally not supported.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/minmax.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/regulator/consumer.h>
+
+/* Single byte commands */
+#define FTS8_CMD_READ_STATUS		0x84
+#define FTS8_CMD_READ_ONE_EVENT		0x85
+#define FTS8_CMD_READ_ALL_EVENT		0x86
+#define FTS8_CMD_SENSE_OFF		0x92
+#define FTS8_CMD_SENSE_ON		0x93
+#define FTS8_CMD_FLUSH_BUFFER		0xa1
+#define FTS8_CMD_FORCE_CALIBRATION	0xa2
+
+/* Hardware register window (0xb6 <addr_hi> <addr_lo> [data...]) */
+#define FTS8_HW_REG			0xb6
+#define FTS8_REG_CHIP_ID		0x0004
+#define FTS8_REG_WARMBOOT		0x001e
+#define FTS8_REG_FIFO_COUNT		0x0023
+#define FTS8_REG_SYSTEM_RESET		0x0028
+#define FTS8_REG_IRQ_CTRL		0x002c
+
+#define FTS8_WARMBOOT_CRC_ENABLE	0x20
+#define FTS8_SYSTEM_RESET_VAL		0x80
+#define FTS8_IRQ_ENABLE			0x48
+#define FTS8_IRQ_DISABLE		0x08
+
+#define FTS8_CHIP_ID0			0x36
+#define FTS8_CHIP_ID1			0x70
+
+/* Events */
+#define FTS8_EV_NO_EVENT		0x00
+#define FTS8_EV_ENTER_POINTER		0x03
+#define FTS8_EV_LEAVE_POINTER		0x04
+#define FTS8_EV_MOTION_POINTER		0x05
+#define FTS8_EV_ERROR			0x0f
+#define FTS8_EV_CONTROLLER_READY	0x10
+
+#define FTS8_EV_ERROR_FLASH_CORRUPTION	0x03
+
+#define FTS8_MASK_EVENT_ID		GENMASK(3, 0)
+
+#define FTS8_EVENT_SIZE			8
+#define FTS8_FIFO_MAX			32
+#define FTS8_MAX_FINGERS		10
+
+/* Raw coordinate range reported by the gtactive2 firmware */
+#define FTS8_DEFAULT_MAX_X		1599
+#define FTS8_DEFAULT_MAX_Y		2559
+
+#define FTS8_READY_RETRIES		12
+#define FTS8_RESET_RETRIES		3
+
+struct fts8_data {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+
+	struct regulator *vdd;
+	struct regulator *avdd;
+	struct gpio_desc *reset_gpio;
+
+	bool running;
+
+	u8 data[FTS8_EVENT_SIZE * FTS8_FIFO_MAX];
+};
+
+static int fts8_write(struct fts8_data *ts, const u8 *buf, int len)
+{
+	int ret;
+
+	ret = i2c_master_send(ts->client, buf, len);
+	if (ret < 0)
+		return ret;
+
+	return ret == len ? 0 : -EIO;
+}
+
+static int fts8_command(struct fts8_data *ts, u8 cmd)
+{
+	return fts8_write(ts, &cmd, 1);
+}
+
+static int fts8_write_hw_reg(struct fts8_data *ts, u16 reg, u8 val)
+{
+	u8 buf[4] = { FTS8_HW_REG, reg >> 8, reg & 0xff, val };
+
+	return fts8_write(ts, buf, sizeof(buf));
+}
+
+static int fts8_read(struct fts8_data *ts, const u8 *wbuf, u16 wlen,
+		     u8 *rbuf, u16 rlen)
+{
+	struct i2c_msg msgs[2] = {
+		{
+			.addr	= ts->client->addr,
+			.len	= wlen,
+			.buf	= (u8 *)wbuf,
+		},
+		{
+			.addr	= ts->client->addr,
+			.flags	= I2C_M_RD,
+			.len	= rlen,
+			.buf	= rbuf,
+		},
+	};
+	int ret;
+
+	ret = i2c_transfer(ts->client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret < 0)
+		return ret;
+
+	return ret == ARRAY_SIZE(msgs) ? 0 : -EIO;
+}
+
+/*
+ * Reads through the hardware register window return one dummy byte
+ * first, which is skipped here. @len must be <= 8.
+ */
+static int fts8_read_hw_reg(struct fts8_data *ts, u16 reg, u8 *val, u16 len)
+{
+	u8 cmd[3] = { FTS8_HW_REG, reg >> 8, reg & 0xff };
+	u8 buf[9];
+	int ret;
+
+	if (len > sizeof(buf) - 1)
+		return -EINVAL;
+
+	ret = fts8_read(ts, cmd, sizeof(cmd), buf, len + 1);
+	if (ret)
+		return ret;
+
+	memcpy(val, &buf[1], len);
+
+	return 0;
+}
+
+static int fts8_wait_for_ready(struct fts8_data *ts)
+{
+	struct device *dev = &ts->client->dev;
+	u8 cmd = FTS8_CMD_READ_ONE_EVENT;
+	u8 ev[FTS8_EVENT_SIZE];
+	int err_cnt = 0;
+	int retry = 0;
+	int ret;
+
+	while (retry < FTS8_READY_RETRIES) {
+		ret = fts8_read(ts, &cmd, 1, ev, sizeof(ev));
+		if (ret)
+			return ret;
+
+		if (ev[0] == FTS8_EV_CONTROLLER_READY)
+			return 0;
+
+		if (ev[0] == FTS8_EV_ERROR) {
+			if (ev[1] == FTS8_EV_ERROR_FLASH_CORRUPTION) {
+				dev_err(dev, "flash corruption: %*ph\n",
+					(int)sizeof(ev), ev);
+				return -EIO;
+			}
+			/* drain queued error events without waiting */
+			if (++err_cnt > FTS8_FIFO_MAX)
+				return -EIO;
+			continue;
+		}
+
+		retry++;
+		msleep(20);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int fts8_hw_init(struct fts8_data *ts)
+{
+	struct device *dev = &ts->client->dev;
+	u8 id[2];
+	int retry;
+	int ret = -ENODEV;
+
+	for (retry = 0; retry < FTS8_RESET_RETRIES; retry++) {
+		/* Not fatal, the vendor driver ignores failures here too */
+		ret = fts8_write_hw_reg(ts, FTS8_REG_WARMBOOT,
+					FTS8_WARMBOOT_CRC_ENABLE);
+		if (ret)
+			dev_dbg(dev, "failed to enable warmboot crc: %d\n", ret);
+		usleep_range(10000, 11000);
+
+		ret = fts8_write_hw_reg(ts, FTS8_REG_SYSTEM_RESET,
+					FTS8_SYSTEM_RESET_VAL);
+		if (ret) {
+			dev_dbg(dev, "system reset failed: %d\n", ret);
+			msleep(20);
+			continue;
+		}
+		usleep_range(10000, 11000);
+
+		ret = fts8_wait_for_ready(ts);
+		if (!ret)
+			break;
+
+		dev_dbg(dev, "controller not ready: %d\n", ret);
+	}
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to reset controller\n");
+
+	ret = fts8_read_hw_reg(ts, FTS8_REG_CHIP_ID, id, sizeof(id));
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip id\n");
+
+	if (id[0] != FTS8_CHIP_ID0 || id[1] != FTS8_CHIP_ID1)
+		dev_warn(dev, "unexpected chip id %02x%02x\n", id[0], id[1]);
+	else
+		dev_dbg(dev, "chip id %02x%02x\n", id[0], id[1]);
+
+	/* Keep the controller quiet until the input device is opened */
+	ret = fts8_write_hw_reg(ts, FTS8_REG_IRQ_CTRL, FTS8_IRQ_DISABLE);
+	if (ret)
+		return ret;
+
+	return fts8_command(ts, FTS8_CMD_FLUSH_BUFFER);
+}
+
+static void fts8_report_contact(struct fts8_data *ts, const u8 *ev)
+{
+	unsigned int slot = ev[0] >> 4;
+	unsigned int x, y, w, h;
+
+	if (slot >= FTS8_MAX_FINGERS)
+		return;
+
+	x = ev[1] | ((ev[2] & 0x0f) << 8);
+	y = (ev[2] >> 4) | (ev[3] << 4);
+	w = ev[4];
+	h = ev[5];
+
+	input_mt_slot(ts->input, slot);
+	input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+	touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+	input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, max(w, h));
+	input_report_abs(ts->input, ABS_MT_TOUCH_MINOR, min(w, h));
+}
+
+static void fts8_report_release(struct fts8_data *ts, const u8 *ev)
+{
+	unsigned int slot = ev[0] >> 4;
+
+	if (slot >= FTS8_MAX_FINGERS)
+		return;
+
+	input_mt_slot(ts->input, slot);
+	input_mt_report_slot_inactive(ts->input);
+}
+
+static void fts8_parse_events(struct fts8_data *ts, unsigned int count)
+{
+	struct device *dev = &ts->client->dev;
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		const u8 *ev = &ts->data[i * FTS8_EVENT_SIZE];
+
+		switch (ev[0] & FTS8_MASK_EVENT_ID) {
+		case FTS8_EV_ENTER_POINTER:
+		case FTS8_EV_MOTION_POINTER:
+			fts8_report_contact(ts, ev);
+			continue;
+		case FTS8_EV_LEAVE_POINTER:
+			fts8_report_release(ts, ev);
+			continue;
+		}
+
+		switch (ev[0]) {
+		case FTS8_EV_NO_EVENT:
+			break;
+		case FTS8_EV_ERROR:
+			dev_warn_ratelimited(dev, "error event: %*ph\n",
+					     FTS8_EVENT_SIZE, ev);
+			break;
+		case FTS8_EV_CONTROLLER_READY:
+			dev_warn_ratelimited(dev, "unexpected controller reset\n");
+			break;
+		default:
+			dev_dbg(dev, "unhandled event: %*ph\n",
+				FTS8_EVENT_SIZE, ev);
+			break;
+		}
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+static irqreturn_t fts8_irq_handler(int irq, void *dev_id)
+{
+	struct fts8_data *ts = dev_id;
+	u8 cmd = FTS8_CMD_READ_ALL_EVENT;
+	unsigned int count;
+	u8 fifo;
+	int ret;
+
+	ret = fts8_read_hw_reg(ts, FTS8_REG_FIFO_COUNT, &fifo, 1);
+	if (ret) {
+		dev_err_ratelimited(&ts->client->dev,
+				    "failed to read fifo count: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	/*
+	 * The vendor driver uses half the register value as the number of
+	 * pending events. Always read at least one event so a level-triggered
+	 * line can never get stuck on an unexpected count of zero; reading an
+	 * empty FIFO just returns NO_EVENT entries.
+	 */
+	count = clamp_t(unsigned int, fifo / 2, 1, FTS8_FIFO_MAX);
+
+	ret = fts8_read(ts, &cmd, 1, ts->data, count * FTS8_EVENT_SIZE);
+	if (ret) {
+		dev_err_ratelimited(&ts->client->dev,
+				    "failed to read events: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	fts8_parse_events(ts, count);
+
+	return IRQ_HANDLED;
+}
+
+static void fts8_release_contacts(struct fts8_data *ts)
+{
+	unsigned int i;
+
+	for (i = 0; i < FTS8_MAX_FINGERS; i++) {
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_inactive(ts->input);
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+static int fts8_start(struct fts8_data *ts)
+{
+	int ret;
+
+	if (ts->running)
+		return 0;
+
+	ret = fts8_command(ts, FTS8_CMD_FLUSH_BUFFER);
+	if (ret)
+		return ret;
+
+	usleep_range(10000, 11000);
+
+	ret = fts8_command(ts, FTS8_CMD_SENSE_ON);
+	if (ret)
+		return ret;
+
+	ret = fts8_command(ts, FTS8_CMD_FORCE_CALIBRATION);
+	if (ret)
+		return ret;
+
+	ret = fts8_write_hw_reg(ts, FTS8_REG_IRQ_CTRL, FTS8_IRQ_ENABLE);
+	if (ret)
+		return ret;
+
+	ts->running = true;
+	enable_irq(ts->client->irq);
+
+	return 0;
+}
+
+static void fts8_stop(struct fts8_data *ts)
+{
+	struct device *dev = &ts->client->dev;
+	int ret;
+
+	if (!ts->running)
+		return;
+
+	disable_irq(ts->client->irq);
+	ts->running = false;
+
+	ret = fts8_write_hw_reg(ts, FTS8_REG_IRQ_CTRL, FTS8_IRQ_DISABLE);
+	if (ret)
+		dev_warn(dev, "failed to disable interrupt: %d\n", ret);
+
+	ret = fts8_command(ts, FTS8_CMD_SENSE_OFF);
+	if (ret)
+		dev_warn(dev, "failed to turn sensing off: %d\n", ret);
+
+	ret = fts8_command(ts, FTS8_CMD_FLUSH_BUFFER);
+	if (ret)
+		dev_warn(dev, "failed to flush event buffer: %d\n", ret);
+
+	fts8_release_contacts(ts);
+}
+
+static int fts8_input_open(struct input_dev *input)
+{
+	struct fts8_data *ts = input_get_drvdata(input);
+
+	return fts8_start(ts);
+}
+
+static void fts8_input_close(struct input_dev *input)
+{
+	struct fts8_data *ts = input_get_drvdata(input);
+
+	fts8_stop(ts);
+}
+
+static int fts8_power_on(struct fts8_data *ts)
+{
+	int ret;
+
+	/* Vendor order: avdd, then vdd (dvdd), then release the chip */
+	ret = regulator_enable(ts->avdd);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 2000);
+
+	ret = regulator_enable(ts->vdd);
+	if (ret) {
+		regulator_disable(ts->avdd);
+		return ret;
+	}
+
+	if (ts->reset_gpio) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	}
+
+	/* Vendor waits 5 ms, give the controller some margin */
+	msleep(20);
+
+	return 0;
+}
+
+static void fts8_power_off(void *data)
+{
+	struct fts8_data *ts = data;
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	regulator_disable(ts->vdd);
+	regulator_disable(ts->avdd);
+}
+
+static int fts8_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct fts8_data *ts;
+	struct input_dev *input;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return -ENODEV;
+
+	if (client->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "no interrupt\n");
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+
+	ts->client = client;
+	i2c_set_clientdata(client, ts);
+
+	ts->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(ts->vdd))
+		return dev_err_probe(dev, PTR_ERR(ts->vdd),
+				     "failed to get vdd regulator\n");
+
+	ts->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(ts->avdd))
+		return dev_err_probe(dev, PTR_ERR(ts->avdd),
+				     "failed to get avdd regulator\n");
+
+	ts->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = fts8_power_on(ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = devm_add_action_or_reset(dev, fts8_power_off, ts);
+	if (ret)
+		return ret;
+
+	ret = fts8_hw_init(ts);
+	if (ret)
+		return ret;
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+
+	ts->input = input;
+	input->name = "STM FTS8 Touchscreen";
+	input->id.bustype = BUS_I2C;
+	input->open = fts8_input_open;
+	input->close = fts8_input_close;
+
+	input_set_abs_params(input, ABS_MT_POSITION_X, 0,
+			     FTS8_DEFAULT_MAX_X, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0,
+			     FTS8_DEFAULT_MAX_Y, 0, 0);
+	touchscreen_parse_properties(input, true, &ts->prop);
+
+	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MINOR, 0, 255, 0, 0);
+
+	ret = input_mt_init_slots(input, FTS8_MAX_FINGERS, INPUT_MT_DIRECT);
+	if (ret)
+		return ret;
+
+	input_set_drvdata(input, ts);
+
+	/* Trigger type (level low on gtactive2) comes from the DT */
+	ret = devm_request_threaded_irq(dev, client->irq, NULL,
+					fts8_irq_handler,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"stm-fts8", ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	ret = input_register_device(input);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register input\n");
+
+	return 0;
+}
+
+static int fts8_suspend(struct device *dev)
+{
+	struct fts8_data *ts = i2c_get_clientdata(to_i2c_client(dev));
+
+	guard(mutex)(&ts->input->mutex);
+
+	if (input_device_enabled(ts->input))
+		fts8_stop(ts);
+
+	return 0;
+}
+
+static int fts8_resume(struct device *dev)
+{
+	struct fts8_data *ts = i2c_get_clientdata(to_i2c_client(dev));
+	int ret;
+
+	guard(mutex)(&ts->input->mutex);
+
+	if (!input_device_enabled(ts->input))
+		return 0;
+
+	ret = fts8_start(ts);
+	if (ret) {
+		/* The controller may have lost power, re-initialize it */
+		dev_warn(dev, "restart failed (%d), resetting controller\n",
+			 ret);
+		ret = fts8_hw_init(ts);
+		if (!ret)
+			ret = fts8_start(ts);
+	}
+
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(fts8_pm_ops, fts8_suspend, fts8_resume);
+
+static const struct of_device_id fts8_of_match[] = {
+	{ .compatible = "st,fts8cd56" },
+	{ .compatible = "st,fts8" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fts8_of_match);
+
+static const struct i2c_device_id fts8_id[] = {
+	{ "fts8cd56" },
+	{ "fts8" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, fts8_id);
+
+static struct i2c_driver fts8_driver = {
+	.driver = {
+		.name = "stm-fts8",
+		.of_match_table = fts8_of_match,
+		.pm = pm_sleep_ptr(&fts8_pm_ops),
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+	},
+	.probe = fts8_probe,
+	.id_table = fts8_id,
+};
+module_i2c_driver(fts8_driver);
+
+MODULE_DESCRIPTION("STMicroelectronics FingerTip FTS8 touchscreen driver");
+MODULE_LICENSE("GPL");
