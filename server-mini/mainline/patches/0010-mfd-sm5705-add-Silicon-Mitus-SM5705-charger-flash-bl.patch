@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/siliconmitus,sm5705.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 charger/flash block
+
+maintainers:
+  - Linux Exynos7870 maintainers <linux-samsung-soc@vger.kernel.org>
+
+description:
+  The SM5705 companion chip contains a charger, flash LED and RGB LED block
+  at I2C address 0x49 with a shared interrupt line. The micro-USB interface
+  controller (siliconmitus,sm5705-muic) and the fuel gauge
+  (siliconmitus,sm5705-fuelgauge) are separate I2C devices.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705
+
+  reg:
+    maxItems: 1
+    description: I2C slave address, 0x49.
+
+  interrupts:
+    maxItems: 1
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@49 {
+            compatible = "siliconmitus,sm5705";
+            reg = <0x49>;
+            interrupt-parent = <&gpa2>;
+            interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
+            wakeup-source;
+        };
+    };
