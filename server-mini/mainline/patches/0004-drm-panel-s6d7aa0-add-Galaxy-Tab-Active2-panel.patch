From 1dc69d25cdac0501d1815a98463a8dbb8d8af774 Mon Sep 17 00:00:00 2001
From: ttabouch12 <ttabouch12@users.noreply.github.com>
Date: Thu, 19 Nov 2026 10:29:02 +0300
Subject: [PATCH 04/21] drm/panel: s6d7aa0: add Galaxy Tab Active2 panel

Add the 800x1280 BOE panel of the Galaxy Tab Active2 (SM-T390/T395).
Init sequence, timings and backlight range follow the vendor driver
(s6d7aa0_gtactive2): DCS backlight through the controller PWM, capped at
225 like the vendor. Also support the panel orientation property and
request the reset GPIO deasserted so a bootloader splash stays visible
until prepare().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C7LhHVoCsrpwunEL6xJhiW
---
 drivers/gpu/drm/panel/panel-samsung-s6d7aa0.c | 124 +++++++++++++++++-
 1 file changed, 120 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6d7aa0.c b/drivers/gpu/drm/panel/panel-samsung-s6d7aa0.c
index 692020081..9119438ff 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6d7aa0.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6d7aa0.c
@@ -13,6 +13,7 @@
 #include <linux/of.h>
 
 #include <video/mipi_display.h>
+#include <drm/drm_connector.h>
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
@@ -30,6 +31,7 @@ struct s6d7aa0 {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data supplies[2];
 	const struct s6d7aa0_panel_desc *desc;
+	enum drm_panel_orientation orientation;
 };
 
 struct s6d7aa0_panel_desc {
@@ -41,12 +43,16 @@ struct s6d7aa0_panel_desc {
 	u32 bus_flags;
 	bool has_backlight;
 	bool use_passwd3;
+	/* DSI backlight range; 0 means the full 0..255 range */
+	u8 bl_max_brightness;
+	u8 bl_default_brightness;
 };
 
 enum s6d7aa0_panels {
 	S6D7AA0_PANEL_LSL080AL02,
 	S6D7AA0_PANEL_LSL080AL03,
 	S6D7AA0_PANEL_LTL101AT01,
+	S6D7AA0_PANEL_GTACTIVE2,
 };
 
 static inline struct s6d7aa0 *panel_to_s6d7aa0(struct drm_panel *panel)
@@ -175,15 +181,23 @@ static const struct backlight_ops s6d7aa0_bl_ops = {
 };
 
 static struct backlight_device *
-s6d7aa0_create_backlight(struct mipi_dsi_device *dsi)
+s6d7aa0_create_backlight(struct mipi_dsi_device *dsi,
+			 const struct s6d7aa0_panel_desc *desc)
 {
 	struct device *dev = &dsi->dev;
-	const struct backlight_properties props = {
+	struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
 		.brightness = 255,
 		.max_brightness = 255,
 	};
 
+	if (desc->bl_max_brightness)
+		props.max_brightness = desc->bl_max_brightness;
+	if (desc->bl_default_brightness)
+		props.brightness = desc->bl_default_brightness;
+	else
+		props.brightness = props.max_brightness;
+
 	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
 					      &s6d7aa0_bl_ops, &props);
 }
@@ -354,6 +368,81 @@ static const struct s6d7aa0_panel_desc s6d7aa0_ltl101at01_desc = {
 	.use_passwd3 = true,
 };
 
+/*
+ * Initialization code and structures for the BOE 8.0" 800x1280 panel of the
+ * Samsung Galaxy Tab Active2 (SM-T390/T395). Sequence, timings and backlight
+ * handling follow the vendor driver (s6d7aa0_gtactive2_lcd_ctrl.c): the
+ * backlight is driven by the PWM output of the S6D7AA0 (DCS 0x51), which
+ * controls an external LED driver ("PMIC_ON" bit in MCS_BL_CTL).
+ */
+
+static void s6d7aa0_gtactive2_init(struct s6d7aa0 *ctx,
+				   struct mipi_dsi_multi_context *dsi_ctx)
+{
+	s6d7aa0_lock(ctx, dsi_ctx, false);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MCS_OTP_RELOAD, 0x00, 0x10);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	/* BL_ON_CTL: PMIC_ON, PWM frequency 24 kHz */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MCS_BL_CTL, 0xc7, 0x00, 0x29);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x51, 0x00);
+	/* PWM enable, dimming enable */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x24, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x00, 0x00);
+	/* PWM manual mode */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc1, 0x01, 0x00);
+	/* Porches: VBP 6 + VSW 2, VFP 8, HBP 48 + HSW 16, HFP 16 */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf2, 0x02, 0x08, 0x08, 0x40, 0x10);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 120);
+
+	s6d7aa0_lock(ctx, dsi_ctx, true);
+
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+}
+
+static void s6d7aa0_gtactive2_off(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	/* Backlight (PWM) off */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x00, 0x00);
+	mipi_dsi_msleep(dsi_ctx, 35);
+}
+
+static const struct drm_display_mode s6d7aa0_gtactive2_mode = {
+	.clock = (800 + 16 + 16 + 48) * (1280 + 8 + 2 + 6) * 60 / 1000,
+	.hdisplay = 800,
+	.hsync_start = 800 + 16,
+	.hsync_end = 800 + 16 + 16,
+	.htotal = 800 + 16 + 16 + 48,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 8,
+	.vsync_end = 1280 + 8 + 2,
+	.vtotal = 1280 + 8 + 2 + 6,
+	.width_mm = 107,
+	.height_mm = 172,
+};
+
+static const struct s6d7aa0_panel_desc s6d7aa0_gtactive2_desc = {
+	.panel_type = S6D7AA0_PANEL_GTACTIVE2,
+	.init_func = s6d7aa0_gtactive2_init,
+	.off_func = s6d7aa0_gtactive2_off,
+	.drm_mode = &s6d7aa0_gtactive2_mode,
+	.mode_flags = MIPI_DSI_MODE_VIDEO_NO_HFP,
+	.bus_flags = 0,
+
+	.has_backlight = true,
+	.use_passwd3 = true,
+	/* Vendor never programs more than 225 (outdoor), 196 at UI maximum */
+	.bl_max_brightness = 225,
+	.bl_default_brightness = 75,
+};
+
 static int s6d7aa0_get_modes(struct drm_panel *panel,
 					struct drm_connector *connector)
 {
@@ -376,14 +465,28 @@ static int s6d7aa0_get_modes(struct drm_panel *panel,
 	connector->display_info.bus_flags = ctx->desc->bus_flags;
 	drm_mode_probed_add(connector, mode);
 
+	/*
+	 * TODO: Remove once all drm drivers call
+	 * drm_connector_set_orientation_from_panel()
+	 */
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+
 	return 1;
 }
 
+static enum drm_panel_orientation s6d7aa0_get_orientation(struct drm_panel *panel)
+{
+	struct s6d7aa0 *ctx = panel_to_s6d7aa0(panel);
+
+	return ctx->orientation;
+}
+
 static const struct drm_panel_funcs s6d7aa0_panel_funcs = {
 	.disable = s6d7aa0_disable,
 	.prepare = s6d7aa0_prepare,
 	.unprepare = s6d7aa0_unprepare,
 	.get_modes = s6d7aa0_get_modes,
+	.get_orientation = s6d7aa0_get_orientation,
 };
 
 static int s6d7aa0_probe(struct mipi_dsi_device *dsi)
@@ -409,7 +512,12 @@ static int s6d7aa0_probe(struct mipi_dsi_device *dsi)
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "Failed to get regulators\n");
 
-	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	/*
+	 * Request reset deasserted, so that a panel initialized by the
+	 * bootloader keeps showing the boot framebuffer until prepare(),
+	 * which performs a full reset cycle anyway.
+	 */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
 	if (IS_ERR(ctx->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset-gpios\n");
@@ -424,13 +532,17 @@ static int s6d7aa0_probe(struct mipi_dsi_device *dsi)
 
 	ctx->panel.prepare_prev_first = true;
 
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get orientation\n");
+
 	ret = drm_panel_of_backlight(&ctx->panel);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to get backlight\n");
 
 	/* Use DSI-based backlight as fallback if available */
 	if (ctx->desc->has_backlight && !ctx->panel.backlight) {
-		ctx->panel.backlight = s6d7aa0_create_backlight(dsi);
+		ctx->panel.backlight = s6d7aa0_create_backlight(dsi, ctx->desc);
 		if (IS_ERR(ctx->panel.backlight))
 			return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
 					     "Failed to create backlight\n");
@@ -473,6 +585,10 @@ static const struct of_device_id s6d7aa0_of_match[] = {
 		.compatible = "samsung,ltl101at01",
 		.data = &s6d7aa0_ltl101at01_desc
 	},
+	{
+		.compatible = "samsung,s6d7aa0-gtactive2",
+		.data = &s6d7aa0_gtactive2_desc
+	},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, s6d7aa0_of_match);
