+/* Exynos7870: IOVA hole fillers below the firmware block (see below) */
+#define MFC_IOVA_FILL_MAX	16
+static struct { void *cpu; dma_addr_t dma; size_t size; } mfc_iova_fill[MFC_IOVA_FILL_MAX];
+
