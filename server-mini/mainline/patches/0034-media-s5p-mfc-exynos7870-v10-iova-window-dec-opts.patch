@@ -1230,8 +1234,39 @@ static int s5p_mfc_configure_common_memory(struct s5p_mfc_dev *mfc_dev)
 	if (!mfc_dev->mem_bitmap)
 		return -ENOMEM;
 
+	/*
+	 * Exynos7870 (MFC 7J, v10): the firmware only accepts buffers placed
+	 * ABOVE its base address (SEQ_HEADER fails with error 0x37 otherwise).
+	 * arm64 iommu-dma hands out IOVAs top-down and continues below the last
+	 * allocation, so: put the firmware/context block at the bottom of the
+	 * IOVA space (8 MiB aligned -> 0x800000), fill the small hole below it,
+	 * and every later allocation wraps around to the top, above the base.
+	 */
+	if (exynos_is_iommu_available(dev) &&
+	    mfc_dev->variant->version == MFC_VERSION_V10)
+		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(ilog2(mem_size) + 1));
+
 	mfc_dev->mem_virt = dma_alloc_coherent(dev, mem_size,
 					       &mfc_dev->mem_base, GFP_KERNEL);
+
+	if (mfc_dev->mem_virt && exynos_is_iommu_available(dev) &&
+	    mfc_dev->variant->version == MFC_VERSION_V10) {
+		size_t sz;
+		int n = 0;
+
+		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(ilog2(mem_size)));
+		for (sz = mem_size / 2; sz >= PAGE_SIZE && n < MFC_IOVA_FILL_MAX; sz /= 2) {
+			mfc_iova_fill[n].cpu = dma_alloc_attrs(dev, sz, &mfc_iova_fill[n].dma,
+					GFP_KERNEL, DMA_ATTR_NO_KERNEL_MAPPING);
+			if (!mfc_iova_fill[n].cpu)
+				break;
+			mfc_iova_fill[n++].size = sz;
+		}
+		/* and keep every buffer within 256 MiB of the firmware base */
+		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(28));
+		dev_info(dev, "firmware base %pad, %d IOVA fillers below it\n",
+			 &mfc_dev->mem_base, n);
+	}
 	if (!mfc_dev->mem_virt) {
 		bitmap_free(mfc_dev->mem_bitmap);
 		dev_err(dev, "failed to preallocate %ld MiB for the firmware and context buffers\n",
@@ -1270,8 +1305,16 @@ static void s5p_mfc_unconfigure_common_memory(struct s5p_mfc_dev *mfc_dev)
 {
 	struct device *dev = &mfc_dev->plat_dev->dev;
 
+	int i;
+
 	dma_free_coherent(dev, mfc_dev->mem_size, mfc_dev->mem_virt,
 			  mfc_dev->mem_base);
+	for (i = 0; i < MFC_IOVA_FILL_MAX; i++)
+		if (mfc_iova_fill[i].cpu) {
+			dma_free_attrs(dev, mfc_iova_fill[i].size, mfc_iova_fill[i].cpu,
+				       mfc_iova_fill[i].dma, DMA_ATTR_NO_KERNEL_MAPPING);
+			mfc_iova_fill[i].cpu = NULL;
+		}
 	bitmap_free(mfc_dev->mem_bitmap);
