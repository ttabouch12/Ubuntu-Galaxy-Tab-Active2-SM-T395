@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5705-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 battery charger
+
+maintainers:
+  - Linux Exynos7870 maintainers <linux-samsung-soc@vger.kernel.org>
+
+description:
+  Battery charger function of the SM5705 companion chip, a child of the
+  siliconmitus,sm5705 MFD node. The float voltage and the termination
+  current are taken from the monitored battery. The input current limit and
+  the fast charge current are selected according to the cable reported by the
+  MUIC extcon device.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705-charger
+
+  enable-gpios:
+    maxItems: 1
+    description:
+      Charging enable pin. The pin is active low on the hardware, so use
+      GPIO_ACTIVE_LOW.
+
+  monitored-battery:
+    description:
+      Battery with constant-charge-voltage-max-microvolt (required, 4.01 V to
+      4.62 V in 10 mV steps) and optionally charge-term-current-microamp
+      (default 250 mA).
+
+  extcon:
+    maxItems: 1
+    description:
+      MUIC extcon device (siliconmitus,sm5705-muic) that reports the
+      attached cable. Without it the SDP limits are always used.
+
+  siliconmitus,sdp-limits-microamp:
+    description:
+      Input current limit and fast charge current for a standard downstream
+      port and for unknown cables.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    default: [450000, 450000]
+
+  siliconmitus,cdp-limits-microamp:
+    description:
+      Input current limit and fast charge current for a charging downstream
+      port.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    default: [1000000, 1000000]
+
+  siliconmitus,dcp-limits-microamp:
+    description:
+      Input current limit and fast charge current for a dedicated charger
+      (vendor "TA" values).
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    default: [1800000, 2100000]
+
+required:
+  - compatible
+  - enable-gpios
+  - monitored-battery
+
+unevaluatedProperties: false
