+static const struct samsung_pll_clock cpucl1_pll_clks[] __initconst = {
+	PLL(pll_1417x, CLK_FOUT_CPUCL1_PLL, "fout_cpucl1_pll", "oscclk",
+	    PLL_LOCKTIME_CPUCL1_PLL, PLL_CON0_CPUCL1_PLL,
+	    exynos7870_cpucl_pll_rates),
+};
+
+/* List of parent clocks for muxes in CMU_CPUCL1 */
+PNAME(mout_cpucl1_switch_user_p)	= { "oscclk", "gout_mif_cmu_cpucl1_switch" };
+
+static const struct samsung_mux_clock cpucl1_mux_clks[] __initconst = {
+	MUX_F(CLK_MOUT_CPUCL1_SWITCH_USER, "mout_cpucl1_switch_user",
+	      mout_cpucl1_switch_user_p, CLK_CON_MUX_CPUCL1_SWITCH_USER, 12, 1,
+	      CLK_SET_RATE_PARENT, 0),
+};
+
+static const struct samsung_gate_clock cpucl1_gate_clks[] __initconst = {
+	GATE(CLK_GOUT_CPUCL1_MUX_SWITCH_USER, "gout_cpucl1_mux_switch_user",
+	     "mout_cpucl1_switch_user", CLK_CON_GAT_CPUCL1_MUX_SWITCH_USER, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_CPUCL1_MUX_PLL, "gout_cpucl1_mux_pll",
+	     "gout_cpucl1_mux_pll_con", CLK_CON_GAT_CPUCL1_MUX_PLL, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_CPUCL1_MUX_PLL_CON, "gout_cpucl1_mux_pll_con",
+	     "fout_cpucl1_pll", CLK_CON_GAT_CPUCL1_MUX_PLL_CON, 12,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+};
+
+static const struct samsung_cpu_clock cpucl1_cpu_clks[] __initconst = {
+	CPU_CLK(CLK_CPUCL1_ARMCLK, "armclk_cpucl1", CLK_GOUT_CPUCL1_MUX_PLL,
+		CLK_GOUT_CPUCL1_MUX_SWITCH_USER, CLK_CPU_HAS_DIV1, 0,
+		CPUCLK_LAYOUT_E7870, exynos7870_cpucl_cfg),
+};
+
+static const struct samsung_cmu_info cpucl1_cmu_info __initconst = {
+	.pll_clks		= cpucl1_pll_clks,
+	.nr_pll_clks		= ARRAY_SIZE(cpucl1_pll_clks),
+	.mux_clks		= cpucl1_mux_clks,
