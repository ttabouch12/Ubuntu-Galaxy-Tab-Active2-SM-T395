+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5705-fuelgauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 fuel gauge
+
+maintainers:
+  - Linux Exynos7870 maintainers <linux-samsung-soc@vger.kernel.org>
+
+description:
+  Voltage-tracking fuel gauge of the Silicon Mitus SM5705 companion chip.
+  The gauge is normally initialised by the bootloader. When the battery model
+  properties are present the driver loads them if the gauge reports that it is
+  not initialised. The register values are those of the Samsung vendor kernel
+  (battery_params node of the board device tree) and are specific to one
+  battery model.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705-fuelgauge
+
+  reg:
+    maxItems: 1
+    description: I2C slave address, 0x71.
+
+  monitored-battery: true
+  power-supplies: true
+
+  siliconmitus,full-permille:
+    description:
+      State of charge, in tenths of a percent as reported by the gauge, that is
+      shown as 100 percent. Corresponds to capacity_max of the vendor tree.
+    minimum: 1
+    maximum: 1000
+    default: 1000
+
+  siliconmitus,discharge-table:
+    description: Discharge (voltage) table, vendor battery0,battery_table0.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 16
+    maxItems: 16
+
+  siliconmitus,q-table:
+    description: Charge (Q) table, vendor battery0,battery_table1.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 16
+    maxItems: 16
+
+  siliconmitus,rce-values:
+    description: RCE0..RCE2 register values, vendor battery0,rce_value.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 3
+    maxItems: 3
+
+  siliconmitus,rs-values:
+    description:
+      Internal resistance parameters, vendor battery0,rs_value. Cells are rs,
+      p_mix_factor, n_mix_factor, max, min. p_mix_factor is not written by
+      the driver.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 5
+    maxItems: 5
+
+  siliconmitus,mix-values:
+    description: Mix rate and mix init blank, vendor battery0,mix_value.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+
+  siliconmitus,topoff-soc:
+    description:
+      Enable flag, top-off state of charge register value and top-off current
+      in mA (informational), vendor battery0,topoff_soc.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 3
+    maxItems: 3
+
+  siliconmitus,cycle-config:
+    description: Cycle counter high limit, low limit and control, vendor battery0,cycle_cfg.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 3
+    maxItems: 3
+
+  siliconmitus,curr-offset:
+    description:
+      Automatic current offset tracking enable flag and current offset
+      register value, vendor battery0,curr_offset.
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+
+  siliconmitus,dtcd-value:
+    description: DTCD register value, vendor battery0,dtcd_value.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  siliconmitus,vit-period:
+    description: VIT period register value, vendor battery0,vit_period.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  siliconmitus,misc:
+    description: MISC register value, vendor battery0,misc.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  siliconmitus,volt-cal:
+    description: Voltage calibration register value, vendor battery0,volt_cal.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  siliconmitus,p-curr-cal:
+    description: Positive current slope calibration, vendor battery0,p_curr_cal.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  siliconmitus,n-curr-cal:
+    description: Negative current slope calibration, vendor battery0,n_curr_cal.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  siliconmitus,data-version:
+    description:
+      Battery data version, must match the one the bootloader programs,
+      vendor battery0,data_ver.
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+required:
+  - compatible
+  - reg
+
+dependencies:
+  siliconmitus,discharge-table:
+    - siliconmitus,q-table
+    - siliconmitus,rce-values
+    - siliconmitus,rs-values
+    - siliconmitus,mix-values
+    - siliconmitus,topoff-soc
+    - siliconmitus,cycle-config
+    - siliconmitus,curr-offset
+    - siliconmitus,dtcd-value
+    - siliconmitus,vit-period
+    - siliconmitus,misc
+    - siliconmitus,volt-cal
+    - siliconmitus,p-curr-cal
+    - siliconmitus,n-curr-cal
+    - siliconmitus,data-version
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    battery: battery {
+        compatible = "simple-battery";
+        voltage-min-design-microvolt = <3400000>;
+        voltage-max-design-microvolt = <4400000>;
+        charge-full-design-microamp-hours = <4450000>;
+    };
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        fuel-gauge@71 {
+            compatible = "siliconmitus,sm5705-fuelgauge";
+            reg = <0x71>;
+            monitored-battery = <&battery>;
+            power-supplies = <&charger>;
+            siliconmitus,full-permille = <990>;
+            siliconmitus,discharge-table = <0x1400 0x1b8a 0x1d19 0x1d7c 0x1d97 0x1df0 0x1e27 0x1e4f
+                                            0x1ebf 0x1ebf 0x1f34 0x1ffc 0x206c 0x2090 0x2151 0x2400>;
+            siliconmitus,q-table = <0x0 0x49 0x12d 0x210 0x4bc 0x684 0x92f 0xda2
+                                    0x12f9 0x12f9 0x14c1 0x1a18 0x1be0 0x1c96 0x1fca 0x1fda>;
+            siliconmitus,rce-values = <0x04e1 0x03e6 0x01d7>;
+            siliconmitus,rs-values = <0x0051 0x147 0x146 0x3800 0x007a>;
+            siliconmitus,mix-values = <0x0403 0x0004>;
+            siliconmitus,topoff-soc = <0 3 200>;
+            siliconmitus,cycle-config = <7 1 3>;
+            siliconmitus,curr-offset = <1 0x0000>;
+            siliconmitus,dtcd-value = <0x1>;
+            siliconmitus,vit-period = <0x3506>;
+            siliconmitus,misc = <0x0060>;
+            siliconmitus,volt-cal = <0x8000>;
+            siliconmitus,p-curr-cal = <0x0061>;
+            siliconmitus,n-curr-cal = <0x005c>;
+            siliconmitus,data-version = <0x8>;
+        };
+    };
