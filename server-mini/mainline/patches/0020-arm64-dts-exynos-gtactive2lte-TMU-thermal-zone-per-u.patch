+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab Active2 LTE (gtactive2lte, SM-T395) device tree source
+ *
+ * Based on exynos7870-j6lte.dts by Kaustabh Chakraborty.
+ * Hardware facts taken from the vendor exynos7870-gtactive2lte_eur_open_04
+ * device tree (hw rev 04).
+ */
+
+/dts-v1/;
+#include "exynos7870.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "Samsung Galaxy Tab Active2 LTE";
+	compatible = "samsung,gtactive2lte", "samsung,exynos7870";
+	chassis-type = "tablet";
+
+	aliases {
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+		mmc2 = &mmc2;
+		serial0 = &serial0;
+		serial1 = &serial1;
+		serial2 = &serial2;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		stdout-path = &serial2;
+
+		/*
+		 * Boot splash framebuffer set up by S-BOOT. Panel memory order
+		 * is R, G, B, X. Removed by exynos-drm once DECON takes over.
+		 */
+		framebuffer@67000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x67000000 (800 * 1280 * 4)>;
+			width = <800>;
+			height = <1280>;
+			stride = <(800 * 4)>;
+			format = "x8b8g8r8";
+
+			/* keep the panel powered until the DRM panel driver owns it */
+			power-supply = <&vdd_lcd>;
+			vmipi-supply = <&vdd_ldo30>;
+		};
+	};
+
+	gpio-hall-effect-sensor {
+		compatible = "gpio-keys";
+		label = "GPIO Hall Effect Sensor";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&hall_irq>;
+
+		event-hall-effect-sensor {
+			label = "Hall Effect Sensor";
+			gpios = <&gpa0 7 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "GPIO Keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home
+			     &key_back &key_recent>;
+
+		key-power {
+			label = "Power Key";
+			gpios = <&gpa0 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+			wakeup-source;
+		};
+
+		key-voldown {
+			label = "Volume Down Key";
+			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+
+		key-volup {
+			label = "Volume Up Key";
+			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+		};
+
+		key-home {
+			label = "Home Key";
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_HOMEPAGE>;
+			wakeup-source;
+		};
+
+		key-back {
+			label = "Back Key";
+			gpios = <&gpc5 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_BACK>;
+		};
+
+		key-recent {
+			label = "Recent Apps Key";
+			gpios = <&gpd1 4 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_APPSELECT>;
+		};
+	};
+
+	/* S-BOOT fills in the real memory layout; these are safe defaults. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x3d800000>,
+		      <0x0 0x80000000 0x80000000>;
+	};
+
+	pwrseq_mmc1: pwrseq-mmc1 {
+		compatible = "mmc-pwrseq-simple";
+		/* WLAN_EN */
+		reset-gpios = <&gpd3 6 GPIO_ACTIVE_LOW>;
+	};
+
+	/* LCD_LDO_EN: panel analog supply, enabled after LCD_1P8 (ldo30) */
+	vdd_lcd: regulator-lcd {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_ldo_en";
+		gpio = <&gpd3 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vdd_ldo30>;
+		startup-delay-us = <1000>;
+		off-on-delay-us = <5000>;
+		regulator-boot-on;
+	};
+
+	/* mmc2: vmmc */
+	vdd_fixed_mmc2: regulator-fixed-mmc2 {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_fixed_mmc2";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&gpc0 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * WLAN_DCDC_EN: main supply of the QCA9377 combo chip. Bluetooth
+	 * (hci_qca, qca9377 has no supply property) depends on it too, so it
+	 * is kept on permanently.
+	 */
+	vdd_wlan: regulator-wlan {
+		compatible = "regulator-fixed";
+		regulator-name = "cnss_dcdc_en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <4000>;
+		gpio = <&gpf3 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	/* TSP_EN: touchscreen analog supply */
+	vdd_tsp_avdd: regulator-tsp-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_avdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpd4 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tsp_avdd_en>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@46e00000 {
+			compatible = "ramoops";
+			reg = <0x0 0x46e00000 0x8000>;
+			console-size = <0x4000>;
+			pmsg-size = <0x4000>;
+		};
+
+		cont_splash_mem: framebuffer@67000000 {
+			reg = <0x0 0x67000000 (800 * 1280 * 4)>;
+			iommu-addresses = <&decon 0x0 0x67000000 (800 * 1280 * 4)>;
+			no-map;
+		};
+
+		/* Used by the secure world (TIMA) in the stock firmware */
+		tima@52a00000 {
+			reg = <0x0 0x52a00000 0x200000>;
+			no-map;
+		};
+
+		/* Cellular / GNSS processors (vendor rmem-3000MB-WUXGA) */
+		cp-init@effff000 {
+			reg = <0x0 0xeffff000 0x1000>;
+			no-map;
+		};
+
+		modem@f0000000 {
+			reg = <0x0 0xf0000000 0x7800000>;
+			no-map;
+		};
+
+		gnss@f7c00000 {
+			reg = <0x0 0xf7c00000 0x400000>;
+			no-map;
+		};
+	};
+};
+
+&decon {
+	memory-region = <&cont_splash_mem>;
+	status = "okay";
+};
+
+&dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,burst-clock-frequency = <500000000>;
+	samsung,esc-clock-frequency = <16000000>;
+	samsung,pll-clock-frequency = <26000000>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,s6d7aa0-gtactive2", "samsung,s6d7aa0";
+		reg = <0>;
+
+		power-supply = <&vdd_lcd>;
+		vmipi-supply = <&vdd_ldo30>;
+		reset-gpios = <&gpd4 1 GPIO_ACTIVE_LOW>;
+
+		/* backlight: DCS (0x51) PWM of the S6D7AA0, see driver */
+
+		/* the panel is mounted upside down */
+		rotation = <180>;
+	};
+};
+
+&gpu {
+	status = "okay";
+};
+
+&hsi2c0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	status = "okay";
+
+	pmic@66 {
+		compatible = "samsung,s2mpu05-pmic";
+		reg = <0x66>;
+		interrupt-parent = <&gpa0>;
+		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pmic_irq>;
+
+		regulators {
+			vdd_buck1: buck1 {
+				regulator-name = "vdd_buck1";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_buck2: buck2 {
+				regulator-name = "vdd_buck2";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_buck3: buck3 {
+				regulator-name = "vdd_buck3";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_buck4: buck4 {
+				regulator-name = "vdd_buck4";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1500000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_buck5: buck5 {
+				regulator-name = "vdd_buck5";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <2100000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo1: ldo1 {
+				regulator-name = "vdd_ldo1";
+				regulator-min-microvolt = <650000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* mmc2: vqmmc */
+			vdd_ldo2: ldo2 {
+				regulator-name = "vdd_ldo2";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			vdd_ldo3: ldo3 {
+				regulator-name = "vdd_ldo3";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <2375000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo4: ldo4 {
+				regulator-name = "vdd_ldo4";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo5: ldo5 {
+				regulator-name = "vdd_ldo5";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo6: ldo6 {
+				regulator-name = "vdd_ldo6";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo7: ldo7 {
+				regulator-name = "vdd_ldo7";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <2375000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* usbdrd: vdd33 */
+			vdd_ldo8: ldo8 {
+				regulator-name = "vdd_ldo8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3375000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			vdd_ldo9: ldo9 {
+				regulator-name = "vdd_ldo9";
+				regulator-min-microvolt = <650000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdd_ldo10: ldo10 {
+				regulator-name = "vdd_ldo10";
+				regulator-min-microvolt = <650000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* audio codec (cod3026x) vdd */
+			vdd_ldo25: ldo25 {
+				regulator-name = "vdd_ldo25";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <2375000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* mmc0: vmmc */
+			vdd_ldo26: ldo26 {
+				regulator-name = "vdd_ldo26";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3375000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			/* mmc0: vqmmc */
+			vdd_ldo27: ldo27 {
+				regulator-name = "vdd_ldo27";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <2375000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			/* GRIP_2P8: grip sensors */
+			vdd_ldo29: ldo29 {
+				regulator-name = "vdd_ldo29";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* LCD_1P8: panel vmipi / vddi */
+			vdd_ldo30: ldo30 {
+				regulator-name = "vdd_ldo30";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+			};
+
+			vdd_ldo31: ldo31 {
+				regulator-name = "vdd_ldo31";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* tsp_dvdd: touchscreen digital supply */
+			vdd_ldo32: ldo32 {
+				regulator-name = "vdd_ldo32";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			/* VDD_CAM_AF_2P8 */
+			vdd_ldo33: ldo33 {
+				regulator-name = "vdd_ldo33";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* VDDIO_1.8V_CAM */
+			vdd_ldo34: ldo34 {
+				regulator-name = "vdd_ldo34";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			/* VDD_CAM_SENSOR_A2P8 */
+			vdd_ldo35: ldo35 {
+				regulator-name = "vdd_ldo35";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+	};
+};
+
+/* Touchscreen bus (vendor i2c@13840000, pins gpc3-0/1) */
+&i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	touchscreen@49 {
+		compatible = "st,fts8cd56", "st,fts8";
+		reg = <0x49>;
+
+		interrupt-parent = <&gpd1>;
+		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq>;
+
+		avdd-supply = <&vdd_tsp_avdd>;
+		vdd-supply = <&vdd_ldo32>;
+
+		/* raw 0..1599 x 0..2559, 2x the panel resolution */
+		touchscreen-size-x = <1600>;
+		touchscreen-size-y = <2560>;
+	};
+};
+
+/* Interface PMIC bus (vendor i2c@13870000): SM5705 @0x49, MUIC @0x25 */
+&i2c4 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	status = "okay";
+
+	/* SM5705 nodes: see the end of this file */
+};
+
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd0_clk &sd0_cmd &sd0_rdqs &sd0_bus1 &sd0_bus4 &sd0_bus8>;
+
+	vmmc-supply = <&vdd_ldo26>;
+	vqmmc-supply = <&vdd_ldo27>;
+
+	fifo-depth = <64>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 4>;
+	samsung,dw-mshc-ddr-timing = <2 4>;
+	non-removable;
+
+	status = "okay";
+};
+
+/* Qualcomm QCA9377 Wi-Fi (ath10k_sdio, enumerated by SDIO id) */
+&mmc1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd1_clk &sd1_cmd &sd1_bus1 &sd1_bus4>;
+
+	mmc-pwrseq = <&pwrseq_mmc1>;
+	vmmc-supply = <&vdd_wlan>;
+
+	bus-width = <4>;
+	fifo-depth = <64>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 3>;
+	samsung,dw-mshc-ddr-timing = <1 2>;
+	non-removable;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+
+	status = "okay";
+};
+
+/* microSD slot */
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &sd2_cd>;
+
+	vmmc-supply = <&vdd_fixed_mmc2>;
+	vqmmc-supply = <&vdd_ldo2>;
+
+	bus-width = <4>;
+	card-detect-delay = <200>;
+	cd-gpios = <&gpa0 1 GPIO_ACTIVE_LOW>;
+	fifo-depth = <64>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 3>;
+	samsung,dw-mshc-ddr-timing = <1 2>;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	disable-wp;
+
+	status = "okay";
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&pinctrl_alive {
+	hall_irq: hall-irq-pins {
+		samsung,pins = "gpa0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_home: key-home-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_power: key-power-pins {
+		samsung,pins = "gpa0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa2-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	pmic_irq: pmic-irq-pins {
+		samsung,pins = "gpa0-2";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR4>;
+	};
+
+	sd2_cd: sd2-cd-pins {
+		samsung,pins = "gpa0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+&pinctrl_top {
+	bt_enable: bt-enable-pins {
+		samsung,pins = "gpd4-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	/* BT_WAKE: not used by hci_qca, keep it driven low like the vendor */
+	bt_wake: bt-wake-pins {
+		samsung,pins = "gpd4-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-val = <0>;
+	};
+
+	key_back: key-back-pins {
+		samsung,pins = "gpc5-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	key_recent: key-recent-pins {
+		samsung,pins = "gpd1-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	tsp_avdd_en: tsp-avdd-en-pins {
+		samsung,pins = "gpd4-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	touch_irq: touch-irq-pins {
+		samsung,pins = "gpd1-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+/* QCA9377 Bluetooth (vendor ttySAC0 = UART @0x13810000) */
+&serial1 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,qca9377-bt";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_enable &bt_wake &bt_hostwake>;
+
+		enable-gpios = <&gpd4 0 GPIO_ACTIVE_HIGH>;
+		max-speed = <3000000>;
+	};
+};
+
+&sd1_bus1 {
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR2>;
+};
+
+&sd1_bus4 {
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR2>;
+};
+
+&sd1_clk {
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR2>;
+};
+
+&sd1_cmd {
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR2>;
+};
+
+&serial2 {
+	status = "okay";
+};
+
+&usbdrd {
+	vdd33-supply = <&vdd_ldo8>;
+
+	status = "okay";
+
+	usb@0 {
+		/*
+		 * Peripheral only for now; switch to "otg" once the SM5705
+		 * MUIC driver provides a usb-role-switch.
+		 */
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+	};
+};
+
+&watchdog_cl0 {
+	status = "okay";
+};
+
+/* ---- SM5705 power (charger, fuel gauge, MUIC) ---- */
+/ {
+	battery: battery {
+		compatible = "simple-battery";
+		/* TODO: verify against the battery label (not in the vendor DT) */
+		charge-full-design-microamp-hours = <4450000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4400000>;	/* z_batterydata:57 battery_type 4400 */
+		constant-charge-voltage-max-microvolt = <4220000>;	/* z_batterydata:196,244 chg_float_voltage */
+		charge-term-current-microamp = <250000>;	/* sm5705_charger.c:1950 TOPOFF 250 mA */
+	};
+};
+
+&i2c4 {
+	samsung,i2c-max-bus-freq = <400000>;	/* common.dtsi:428 */
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	pmic@49 {				/* common.dtsi:430-433 */
+		compatible = "siliconmitus,sm5705";
+		reg = <0x49>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&sm5705_irq>;
+		interrupt-parent = <&gpa2>;
+		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;	/* common.dtsi:436, IRQF_TRIGGER_LOW in sm5705-irq.c */
+
+		charger: charger {
+			compatible = "siliconmitus,sm5705-charger";
+			pinctrl-names = "default";
+			pinctrl-0 = <&chg_en &thm_mux>;	/* common.dtsi:435 */
+			enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;	/* z_batterydata:240 chg_gpio_en, polarity_en 0 */
+			monitored-battery = <&battery>;
+			extcon = <&muic>;
+		};
+	};
+
+	muic: extcon@25 {			/* common.dtsi:461-470 */
+		compatible = "siliconmitus,sm5705-muic";
+		reg = <0x25>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&muic_irq>;
+		interrupt-parent = <&gpa2>;
+		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;	/* common.dtsi:468; edge: sm5705-muic.c:1735 */
+	};
+};
+
+&i2c0 {					/* vendor i2c@13830000, z_batterydata:38 */
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	fuel-gauge@71 {			/* z_batterydata:40-42 */
+		compatible = "siliconmitus,sm5705-fuelgauge";
+		reg = <0x71>;
+		monitored-battery = <&battery>;
+		power-supplies = <&charger>;
+		siliconmitus,full-permille = <990>;	/* :47 capacity_max */
+		siliconmitus,discharge-table = <0x1400 0x1b8a 0x1d19 0x1d7c 0x1d97 0x1df0 0x1e27 0x1e4f
+						0x1ebf 0x1ebf 0x1f34 0x1ffc 0x206c 0x2090 0x2151 0x2400>;	/* :58 */
+		siliconmitus,q-table = <0x0 0x49 0x12d 0x210 0x4bc 0x684 0x92f 0xda2
+					0x12f9 0x12f9 0x14c1 0x1a18 0x1be0 0x1c96 0x1fca 0x1fda>;	/* :59 */
+		siliconmitus,rce-values = <0x04e1 0x03e6 0x01d7>;		/* :60 */
+		siliconmitus,rs-values = <0x0051 0x147 0x146 0x3800 0x007a>;	/* :61 */
+		siliconmitus,mix-values = <0x0403 0x0004>;			/* :70 */
+		siliconmitus,topoff-soc = <0 3 200>;				/* :63 */
+		siliconmitus,cycle-config = <7 1 3>;				/* :76 */
+		siliconmitus,curr-offset = <1 0x0000>;				/* :67 */
+		siliconmitus,dtcd-value = <0x1>;				/* :65 */
+		siliconmitus,vit-period = <0x3506>;				/* :64 */
+		siliconmitus,misc = <0x0060>;					/* :62 */
+		siliconmitus,volt-cal = <0x8000>;				/* :66 */
+		siliconmitus,p-curr-cal = <0x0061>;				/* :68 */
+		siliconmitus,n-curr-cal = <0x005c>;				/* :69 */
+		siliconmitus,data-version = <0x8>;				/* :83 */
+	};
+};
+
+&pinctrl_alive {			/* vendor pinctrl@139F0000 = gpa banks */
+	sm5705_irq: sm5705-irq-pins {	/* common.dtsi:411-416 if_irq */
+		samsung,pins = "gpa2-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	muic_irq: muic-irq-pins {	/* common.dtsi:418-423 */
+		samsung,pins = "gpa2-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+&pinctrl_top {				/* vendor pinctrl@139B0000 = gpd banks */
+	chg_en: chg-en-pins {		/* z_batterydata:23-29 */
+		samsung,pins = "gpd1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	thm_mux: thm-mux-pins {		/* z_batterydata:30-36 */
+		samsung,pins = "gpd4-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+&usbdrd {
+	usb@0 {
+		extcon = <&muic>;
+	};
+};
+
+/* ---- CPU frequency scaling: both clusters on S2MPU05 BUCK1 ---- */
+&cpu0 { cpu-supply = <&vdd_buck1>; };
+&cpu1 { cpu-supply = <&vdd_buck1>; };
+&cpu2 { cpu-supply = <&vdd_buck1>; };
+&cpu3 { cpu-supply = <&vdd_buck1>; };
+&cpu4 { cpu-supply = <&vdd_buck1>; };
+&cpu5 { cpu-supply = <&vdd_buck1>; };
+&cpu6 { cpu-supply = <&vdd_buck1>; };
+&cpu7 { cpu-supply = <&vdd_buck1>; };
+
+/* ---- CPU temperature (TMU, read-only driver) + 90 C throttle zone ---- */
+/ {
+	tmu: tmu@10130000 {
+		compatible = "samsung,exynos7870-tmu";
+		reg = <0x0 0x10130000 0x200>;
+		#thermal-sensor-cells = <0>;
+	};
+
+	thermal-zones {
+		cpu-thermal {
+			polling-delay-passive = <1000>;
+			polling-delay = <2000>;
+			thermal-sensors = <&tmu>;
+
+			trips {
+				cpu_hot: cpu-hot {
+					temperature = <90000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				cpu_crit: cpu-crit {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+};
+
+/* ---- SAFE / diagnostic variant: untested blocks off, boot log on the simple framebuffer ---- */
+&cmu_cpucl0 { status = "disabled"; };
+&cmu_cpucl1 { status = "disabled"; };
+&cpu0 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu1 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu2 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu3 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu4 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu5 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu6 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu7 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&decon { status = "disabled"; };
+&dsi { status = "disabled"; };
+&gpu { status = "disabled"; };
+&charger { status = "disabled"; };
+&muic { status = "disabled"; };
+&i2c0 { status = "disabled"; };
+&usbdrd { usb@0 { /delete-property/ extcon; }; };
+&i2c4 { pmic@49 { status = "disabled"; }; };
diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtactive2lte-safe2.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtactive2lte-safe2.dts
new file mode 100644
index 000000000..8d2464e20
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos7870-gtactive2lte-safe2.dts
@@ -0,0 +1,960 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab Active2 LTE (gtactive2lte, SM-T395) device tree source
+ *
+ * Based on exynos7870-j6lte.dts by Kaustabh Chakraborty.
+ * Hardware facts taken from the vendor exynos7870-gtactive2lte_eur_open_04
+ * device tree (hw rev 04).
+ */
+
+/dts-v1/;
+#include "exynos7870.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "Samsung Galaxy Tab Active2 LTE";
+	compatible = "samsung,gtactive2lte", "samsung,exynos7870";
+	chassis-type = "tablet";
+
+	aliases {
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+		mmc2 = &mmc2;
+		serial0 = &serial0;
+		serial1 = &serial1;
+		serial2 = &serial2;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		stdout-path = &serial2;
+
+		/*
+		 * Boot splash framebuffer set up by S-BOOT. Panel memory order
+		 * is R, G, B, X. Removed by exynos-drm once DECON takes over.
+		 */
+		framebuffer@67000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x67000000 (800 * 1280 * 4)>;
+			width = <800>;
+			height = <1280>;
+			stride = <(800 * 4)>;
+			format = "x8b8g8r8";
+
+			/* keep the panel powered until the DRM panel driver owns it */
+			power-supply = <&vdd_lcd>;
+			vmipi-supply = <&vdd_ldo30>;
+		};
+	};
+
+	gpio-hall-effect-sensor {
+		compatible = "gpio-keys";
+		label = "GPIO Hall Effect Sensor";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&hall_irq>;
+
+		event-hall-effect-sensor {
+			label = "Hall Effect Sensor";
+			gpios = <&gpa0 7 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "GPIO Keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home
+			     &key_back &key_recent>;
+
+		key-power {
+			label = "Power Key";
+			gpios = <&gpa0 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+			wakeup-source;
+		};
+
+		key-voldown {
+			label = "Volume Down Key";
+			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+
+		key-volup {
+			label = "Volume Up Key";
+			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+		};
+
+		key-home {
+			label = "Home Key";
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_HOMEPAGE>;
+			wakeup-source;
+		};
+
+		key-back {
+			label = "Back Key";
+			gpios = <&gpc5 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_BACK>;
+		};
+
+		key-recent {
+			label = "Recent Apps Key";
+			gpios = <&gpd1 4 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_APPSELECT>;
+		};
+	};
+
+	/* S-BOOT fills in the real memory layout; these are safe defaults. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x3d800000>,
+		      <0x0 0x80000000 0x80000000>;
+	};
+
+	pwrseq_mmc1: pwrseq-mmc1 {
+		compatible = "mmc-pwrseq-simple";
+		/* WLAN_EN */
+		reset-gpios = <&gpd3 6 GPIO_ACTIVE_LOW>;
+	};
+
+	/* LCD_LDO_EN: panel analog supply, enabled after LCD_1P8 (ldo30) */
+	vdd_lcd: regulator-lcd {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_ldo_en";
+		gpio = <&gpd3 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vdd_ldo30>;
+		startup-delay-us = <1000>;
+		off-on-delay-us = <5000>;
+		regulator-boot-on;
+	};
+
+	/* mmc2: vmmc */
+	vdd_fixed_mmc2: regulator-fixed-mmc2 {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_fixed_mmc2";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&gpc0 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * WLAN_DCDC_EN: main supply of the QCA9377 combo chip. Bluetooth
+	 * (hci_qca, qca9377 has no supply property) depends on it too, so it
+	 * is kept on permanently.
+	 */
+	vdd_wlan: regulator-wlan {
+		compatible = "regulator-fixed";
+		regulator-name = "cnss_dcdc_en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <4000>;
+		gpio = <&gpf3 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	/* TSP_EN: touchscreen analog supply */
+	vdd_tsp_avdd: regulator-tsp-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_avdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpd4 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tsp_avdd_en>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@46e00000 {
+			compatible = "ramoops";
+			reg = <0x0 0x46e00000 0x8000>;
+			console-size = <0x4000>;
+			pmsg-size = <0x4000>;
