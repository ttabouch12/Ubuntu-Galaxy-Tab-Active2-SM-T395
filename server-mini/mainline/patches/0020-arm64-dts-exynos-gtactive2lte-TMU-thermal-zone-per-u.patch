+	status = "okay";
+
+	fuel-gauge@71 {			/* z_batterydata:40-42 */
+		compatible = "siliconmitus,sm5705-fuelgauge";
+		reg = <0x71>;
+		monitored-battery = <&battery>;
+		power-supplies = <&charger>;
+		siliconmitus,full-permille = <990>;	/* :47 capacity_max */
+		siliconmitus,discharge-table = <0x1400 0x1b8a 0x1d19 0x1d7c 0x1d97 0x1df0 0x1e27 0x1e4f
+						0x1ebf 0x1ebf 0x1f34 0x1ffc 0x206c 0x2090 0x2151 0x2400>;	/* :58 */
+		siliconmitus,q-table = <0x0 0x49 0x12d 0x210 0x4bc 0x684 0x92f 0xda2
+					0x12f9 0x12f9 0x14c1 0x1a18 0x1be0 0x1c96 0x1fca 0x1fda>;	/* :59 */
+		siliconmitus,rce-values = <0x04e1 0x03e6 0x01d7>;		/* :60 */
+		siliconmitus,rs-values = <0x0051 0x147 0x146 0x3800 0x007a>;	/* :61 */
+		siliconmitus,mix-values = <0x0403 0x0004>;			/* :70 */
+		siliconmitus,topoff-soc = <0 3 200>;				/* :63 */
+		siliconmitus,cycle-config = <7 1 3>;				/* :76 */
+		siliconmitus,curr-offset = <1 0x0000>;				/* :67 */
+		siliconmitus,dtcd-value = <0x1>;				/* :65 */
+		siliconmitus,vit-period = <0x3506>;				/* :64 */
+		siliconmitus,misc = <0x0060>;					/* :62 */
+		siliconmitus,volt-cal = <0x8000>;				/* :66 */
+		siliconmitus,p-curr-cal = <0x0061>;				/* :68 */
+		siliconmitus,n-curr-cal = <0x005c>;				/* :69 */
+		siliconmitus,data-version = <0x8>;				/* :83 */
+	};
+};
+
+&pinctrl_alive {			/* vendor pinctrl@139F0000 = gpa banks */
+	sm5705_irq: sm5705-irq-pins {	/* common.dtsi:411-416 if_irq */
+		samsung,pins = "gpa2-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	muic_irq: muic-irq-pins {	/* common.dtsi:418-423 */
+		samsung,pins = "gpa2-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+&pinctrl_top {				/* vendor pinctrl@139B0000 = gpd banks */
+	chg_en: chg-en-pins {		/* z_batterydata:23-29 */
+		samsung,pins = "gpd1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+
+	thm_mux: thm-mux-pins {		/* z_batterydata:30-36 */
+		samsung,pins = "gpd4-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+&usbdrd {
+	usb@0 {
+		extcon = <&muic>;
+	};
+};
+
+/* ---- CPU frequency scaling: both clusters on S2MPU05 BUCK1 ---- */
+&cpu0 { cpu-supply = <&vdd_buck1>; };
+&cpu1 { cpu-supply = <&vdd_buck1>; };
+&cpu2 { cpu-supply = <&vdd_buck1>; };
+&cpu3 { cpu-supply = <&vdd_buck1>; };
+&cpu4 { cpu-supply = <&vdd_buck1>; };
+&cpu5 { cpu-supply = <&vdd_buck1>; };
+&cpu6 { cpu-supply = <&vdd_buck1>; };
+&cpu7 { cpu-supply = <&vdd_buck1>; };
+
+/* ---- CPU temperature (TMU, read-only driver) + 90 C throttle zone ---- */
+/ {
+	tmu: tmu@10130000 {
+		compatible = "samsung,exynos7870-tmu";
+		reg = <0x0 0x10130000 0x200>;
+		#thermal-sensor-cells = <0>;
+	};
+
+	thermal-zones {
+		cpu-thermal {
+			polling-delay-passive = <1000>;
+			polling-delay = <2000>;
+			thermal-sensors = <&tmu>;
+
+			trips {
+				cpu_hot: cpu-hot {
+					temperature = <90000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				cpu_crit: cpu-crit {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+};
+
+/*
+ * CPU voltages: this unit's ECT/ASV values read on the vendor kernel (1586 MHz = 1.00625 V,
+ * 1690 = 1.06875 V; 1794 = 1.0875 V tested stable with an error-checking load, lowest stable 1.05 V).
+ * Below 1586 MHz the ECT levels were not dumped: 1014-1482 MHz reuse the 1586 MHz voltage and the lower
+ * OPPs keep >= 50 mV above the vendor DT fallback (900/800 mV). Safe first; can be trimmed after a dump.
+ * 1924/2002 MHz reset under 8-core load (PMIC current limit); 1898-2002 MHz on 4 cores at up to 1.275 V
+ * also hung on mainline. Not listed: 1794 MHz is this chip's ceiling.
+ * <target min max>: both clusters share BUCK1, so each OPP accepts a higher voltage set by the other cluster.
+ */
+&cluster0_opp_table {
+	opp-1794000000 { opp-microvolt = <1087500 1087500 1300000>; };
+	opp-1690000000 { opp-microvolt = <1068750 1068750 1300000>; };
+	opp-1586000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1482000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1352000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1248000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1144000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1014000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-902000000 { opp-microvolt = <950000 950000 1300000>; };
+	opp-839000000 { opp-microvolt = <950000 950000 1300000>; };
+	opp-757000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-676000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-546000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-449000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-343000000 { opp-microvolt = <925000 925000 1300000>; };
+};
+&cluster1_opp_table {
+	opp-1794000000 { opp-microvolt = <1087500 1087500 1300000>; };
+	opp-1690000000 { opp-microvolt = <1068750 1068750 1300000>; };
+	opp-1586000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1482000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1352000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1248000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1144000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1014000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-902000000 { opp-microvolt = <950000 950000 1300000>; };
+	opp-839000000 { opp-microvolt = <950000 950000 1300000>; };
+	opp-757000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-676000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-546000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-449000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-343000000 { opp-microvolt = <925000 925000 1300000>; };
+};
+
+/* ---- SAFE2 variant: power (SM5705) on; CPU clocks + DRM display still off: untested blocks off, boot log on the simple framebuffer ---- */
+&cmu_cpucl0 { status = "disabled"; };
+&cmu_cpucl1 { status = "disabled"; };
+&cpu0 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu1 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu2 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu3 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu4 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu5 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu6 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&cpu7 { /delete-property/ clocks; /delete-property/ operating-points-v2; /delete-property/ cpu-supply; };
+&decon { status = "disabled"; };
+&dsi { status = "disabled"; };
+&gpu { status = "disabled"; };
diff --git a/arch/arm64/boot/dts/exynos/exynos7870-gtactive2lte-safe3.dts b/arch/arm64/boot/dts/exynos/exynos7870-gtactive2lte-safe3.dts
