+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq>;
+
+		avdd-supply = <&vdd_tsp_avdd>;
+		vdd-supply = <&vdd_ldo32>;
+
+		/* raw 0..1599 x 0..2559, 2x the panel resolution */
+		touchscreen-size-x = <1600>;
+		touchscreen-size-y = <2560>;
+	};
+};
