+		cont_splash_mem: framebuffer@67000000 {
+			reg = <0x0 0x67000000 (800 * 1280 * 4)>;
+			iommu-addresses = <&decon 0x0 0x67000000 (800 * 1280 * 4)>;
+			no-map;
+		};
+
+		/* Used by the secure world (TIMA) in the stock firmware */
+		tima@52a00000 {
+			reg = <0x0 0x52a00000 0x200000>;
+			no-map;
+		};
