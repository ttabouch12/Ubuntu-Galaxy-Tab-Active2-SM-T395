+/*
+ * CPU voltages: this unit's ECT/ASV values read on the vendor kernel (1586 MHz = 1.00625 V,
+ * 1690 = 1.06875 V; 1794 = 1.0875 V tested stable with an error-checking load, lowest stable 1.05 V).
+ * Below 1586 MHz the ECT levels were not dumped: 1014-1482 MHz reuse the 1586 MHz voltage and the lower
+ * OPPs keep >= 50 mV above the vendor DT fallback (900/800 mV). Safe first; can be trimmed after a dump.
+ * 1924/2002 MHz reset under 8-core load (PMIC current limit); 1898-2002 MHz on 4 cores at up to 1.275 V
+ * also hung on mainline. Not listed: 1794 MHz is this chip's ceiling.
+ * <target min max>: both clusters share BUCK1, so each OPP accepts a higher voltage set by the other cluster.
+ */
+&cluster0_opp_table {
+	opp-1794000000 { opp-microvolt = <1087500 1087500 1300000>; };
+	opp-1690000000 { opp-microvolt = <1068750 1068750 1300000>; };
+	opp-1586000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1482000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1352000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1248000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1144000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-1014000000 { opp-microvolt = <1006250 1006250 1300000>; };
+	opp-902000000 { opp-microvolt = <950000 950000 1300000>; };
+	opp-839000000 { opp-microvolt = <950000 950000 1300000>; };
+	opp-757000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-676000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-546000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-449000000 { opp-microvolt = <925000 925000 1300000>; };
+	opp-343000000 { opp-microvolt = <925000 925000 1300000>; };
+};
+&cluster1_opp_table {
