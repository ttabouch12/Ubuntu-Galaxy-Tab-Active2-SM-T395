+++ b/Documentation/devicetree/bindings/extcon/siliconmitus,sm5705-muic.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/extcon/siliconmitus,sm5705-muic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 MUIC (Micro-USB Interface Controller)
+
+maintainers:
+  - Linux Exynos7870 maintainers <linux-samsung-soc@vger.kernel.org>
+
+description:
+  The MUIC block of the Silicon Mitus SM5705 companion chip detects the
+  accessory or charger attached to the USB connector and routes the D+/D-
+  lines to the USB controller. The charger and the fuel gauge of the same
+  chip are separate I2C devices, see siliconmitus,sm5705-charger and
+  siliconmitus,sm5705-fuelgauge.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705-muic
+
+  reg:
+    maxItems: 1
+    description: I2C slave address, 0x25.
+
+  interrupts:
+    maxItems: 1
+
+  connector:
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        extcon@25 {
+            compatible = "siliconmitus,sm5705-muic";
+            reg = <0x25>;
+            interrupt-parent = <&gpa2>;
+            interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
+        };
+    };
