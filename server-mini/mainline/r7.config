# r7: speed + features (on top of gta2-full.config)
CONFIG_LOCALVERSION="-gta2srv-r7"
# network: BBR + fq default qdisc, fq_codel/CAKE available, WireGuard, iptables raw (Docker without the insecure env)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_WIREGUARD=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
# filesystems for SD cards / USB drives
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_F2FS_FS=y
CONFIG_USB_UAS=y
# Wi-Fi: debugfs to limit A-MSDU/A-MPDU bursts (firmware crashes under load)
# CONFIG_ATH10K_DEBUGFS is not set (debugfs cal-data read breaks ath10k_sdio at init)
CONFIG_MAC80211_DEBUGFS=y
# less overhead
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_AUTOGROUP is not set
